//! Flag-isolated request-level replay for arbitrary PLENA `(M, K, N)` cores.
//!
//! This path deliberately does not alter the functional emulator. It consumes
//! an already validated Shared-MoE route manifest, reconstructs the compiler's
//! MX weight layout, and compares a candidate core composition against the
//! monolithic `(4, 1024, 4)` baseline. Both runs issue identical 64-byte HBM
//! requests through a fresh Ramulator instance.
//!
//! Compute is scheduled as aligned rectangular tensor slices. One atomic work
//! item is one token, one output element, and one 64-element K slice, but a
//! dispatched task must remain inside one core's physical `(M, K, N)` box.
//! Missing token rows and K tails therefore consume real issue capacity instead
//! of being repacked into unrelated output coordinates. This is the main
//! discretization missing from the analytical Stream-K upper bound.

use std::collections::{BTreeMap, BTreeSet, VecDeque};
use std::mem::ManuallyDrop;
use std::path::Path;
use std::sync::{Arc, Mutex};

use futures_util::stream::{FuturesUnordered, StreamExt};
use memory::{ErasedMemoryModel, MemoryModel};
use runtime::{Executor, Instant};
use serde::{Deserialize, Serialize};
use sha2::{Digest, Sha256};
use tokio::sync::mpsc;

use crate::runtime_config::{
    PERIOD, SCALAR_INT_BASIC_CYCLES, VECTOR_ADD_CYCLES, VECTOR_EXP_CYCLES, VECTOR_MUL_CYCLES,
    VECTOR_RECI_CYCLES,
};

const BASELINE_PES: u64 = 4096;
const PROVISIONED_INPUT_WIDTH: u64 = 1024;
const PROVISIONED_OUTPUT_SLOTS: u64 = 16;
const COMPILER_MLEN: u64 = 64;
const MX_BLOCK: u64 = 8;
const HBM_BURST_BYTES: u64 = 64;
const HBM_CHANNELS: usize = 8;
const HBM_MAX_IN_FLIGHT: usize = 4096;
const HBM_THEORETICAL_BYTES_PER_CYCLE: f64 = 128.0;
const TRANSFERRED_HBM_REFERENCE_BYTES_PER_CYCLE: f64 = 39.717_745_692_89;
const PANEL_N: u64 = 64;
const M_MM_OVERHEAD: u64 = 8;
const FIXED_OUTPUT_CYCLES: u64 = 17;
const REDUCTION_WIDTH: u64 = 64;
const REDUCTION_SYNC_CYCLES: u64 = 4;
const COMPLETION_CYCLES: u64 = 32;
const MAX_TASK_OUTPUTS: usize = PROVISIONED_OUTPUT_SLOTS as usize;

/// Opt-in experiment: model the compiler's scale-inlined, tile-major weight
/// layout instead of the current row-major layout with a separate scale
/// region.  Under the current layout every 64-element row costs one 64B
/// element burst plus one 64B scale burst of which only 8B are useful
/// (2.00 B/param).  Inlined, eight consecutive k-rows of one 64-column block
/// form a contiguous 512B element + 64B scale group = 576B = nine bursts, so a
/// 64x64 tile costs 72 bursts instead of 128 (1.125 B/param).  Nothing else
/// changes: same panels, same consumption order, same completion semantics.
/// Enabled by `PLENA_MKN_INLINE_SCALE_LAYOUT=1` (set by `--inline-scale-layout`).
const INLINE_GROUP_ROWS: u64 = 8;
const INLINE_GROUP_BYTES: u64 = INLINE_GROUP_ROWS * HBM_BURST_BYTES + HBM_BURST_BYTES; // 576
const INLINE_TILE_BYTES: u64 = (COMPILER_MLEN / INLINE_GROUP_ROWS) * INLINE_GROUP_BYTES; // 4608

/// Opt-in experiment: model today's compiler, which emits one routed job per
/// (token, top-k slot) pair and reloads the expert weights for every pair,
/// instead of one grouped job per expert.  Bytes, padding and completion
/// bookkeeping all follow from the job list, so nothing else changes.
/// Enabled by `PLENA_MKN_PAIR_MAJOR=1` (set by `--pair-major`).
fn pair_major_jobs() -> bool {
    static FLAG: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
    *FLAG.get_or_init(|| {
        std::env::var("PLENA_MKN_PAIR_MAJOR")
            .map(|v| v == "1" || v.eq_ignore_ascii_case("true"))
            .unwrap_or(false)
    })
}

fn inline_scale_layout() -> bool {
    static FLAG: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
    *FLAG.get_or_init(|| {
        std::env::var("PLENA_MKN_INLINE_SCALE_LAYOUT")
            .map(|v| v == "1" || v.eq_ignore_ascii_case("true"))
            .unwrap_or(false)
    })
}

#[derive(Clone, Debug, Deserialize, Serialize)]
pub(crate) struct MknCore {
    #[serde(default)]
    pub(crate) id: usize,
    pub(crate) m: u64,
    pub(crate) k: u64,
    pub(crate) n: u64,
}

impl MknCore {
    fn pes(&self) -> u64 {
        self.k * self.n
    }

    fn output_slots(&self) -> u64 {
        self.m * self.n
    }

    fn atom_capacity(&self) -> u64 {
        self.m * (self.k / COMPILER_MLEN) * self.n
    }

    fn tile_cycles(&self) -> u64 {
        let operand_load = self.m.max(self.n);
        let fill_drain = self.m + self.n + M_MM_OVERHEAD;
        let k_blocks = self.k.div_ceil(MX_BLOCK);
        let k_reduction = if k_blocks <= 1 {
            0
        } else {
            k_blocks.next_power_of_two().ilog2() as u64
        };
        operand_load + fill_drain + k_reduction + self.m + FIXED_OUTPUT_CYCLES
    }
}

