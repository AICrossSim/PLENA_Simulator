struct SharedGateProjection {
    base: u64,
    physical_bytes: u64,
    vector_cycles: u64,
}

#[derive(Clone, Debug)]
struct LogicalJob {
    id: usize,
    kind: JobKind,
    expert_id: Option<u64>,
    tokens: u64,
    token_ids: Vec<u64>,
    projections: [Projection; 3],
    shared_gate: Option<SharedGateProjection>,
}

#[derive(Clone, Debug)]
struct WeightPanel {
    id: usize,
    job_id: usize,
    projection: usize,
    tokens: u64,
    tensor: Projection,
    n_start: u64,
    n_stop: u64,
    m_tile: u64,
    k_tile: u64,
}

impl WeightPanel {
    fn k_blocks(&self) -> u64 {
        self.tensor.k / COMPILER_MLEN
    }

    fn output_count(&self) -> u64 {
        self.tokens * (self.n_stop - self.n_start)
    }

    fn physical_bytes(&self) -> u64 {
        let blocks = self.k_blocks() * (self.n_stop - self.n_start) / COMPILER_MLEN;
        if inline_scale_layout() {
            blocks * INLINE_TILE_BYTES
        } else {
            blocks * 2 * COMPILER_MLEN * HBM_BURST_BYTES
        }
    }
}

fn align_up(value: u64, alignment: u64) -> u64 {
    value.div_ceil(alignment) * alignment
}

fn min3(a: u64, b: u64, c: u64) -> u64 {
    a.min(b).min(c)
}

fn stored_mx_bytes(k: u64, n: u64) -> u64 {
    let elements = k * n;
    align_up(elements + elements / MX_BLOCK, HBM_BURST_BYTES)
}

fn recipe_sram_peak(recipe: &MicroTileRecipe) -> RecipeSramPeak {
    let packed_tile = |k: u64, n: u64| {
        let elements = k * n;
        align_up(elements + elements / MX_BLOCK, HBM_BURST_BYTES)
    };
    let activation = |elements: u64| align_up(elements * 2, HBM_BURST_BYTES);
    let accumulator = |elements: u64| align_up(elements * 4, HBM_BURST_BYTES);

    let stage0_matrix =
        2 * recipe.gate_up_buffer_depth as u64 * packed_tile(recipe.k_h, recipe.n_i);
    let stage1_matrix = recipe.down_buffer_depth as u64 * packed_tile(recipe.n_i, recipe.n_o);
    let input = activation(recipe.m_t * recipe.k_h);
    let gate = activation(recipe.m_t * recipe.n_i);
    let up = activation(recipe.m_t * recipe.n_i);
    let post_swiglu = activation(recipe.m_t * recipe.n_i);
    let output = activation(recipe.m_t * recipe.n_o);
    let vector_bytes = (input + gate + up)
        .max(gate + up + post_swiglu)
        .max(post_swiglu + output);
    let accumulator_slots = (2 * recipe.m_t * recipe.n_i.div_ceil(COMPILER_MLEN))
        .max(recipe.m_t * recipe.n_o.div_ceil(COMPILER_MLEN));
    let accumulator_elements = (2 * recipe.m_t * recipe.n_i).max(recipe.m_t * recipe.n_o);
    RecipeSramPeak {
        matrix_bytes: stage0_matrix.max(stage1_matrix),
        vector_bytes,
        accumulator_bytes: accumulator(accumulator_elements),
        accumulator_slots,
    }
}

fn shared_gate_vector_cycles(tokens: u64, hidden: u64) -> u64 {
    let k_blocks = hidden.div_ceil(COMPILER_MLEN);
    let physical_rows = tokens.div_ceil(4) * 4;
    let dot_and_sigmoid = 3 + tokens * (10 + 12 * k_blocks);
    let clear_and_broadcast = 195 + physical_rows * k_blocks * 65 + tokens * (196 + k_blocks * 66);
    let apply_gate = tokens * k_blocks * 3;
    dot_and_sigmoid + clear_and_broadcast + apply_gate
}

fn activation_vector_cycles(tokens: u64, intermediate: u64) -> u64 {
    let chunks = tokens * intermediate.div_ceil(COMPILER_MLEN);
    let cycles_per_chunk = 2 * u64::from(*VECTOR_ADD_CYCLES)
        + u64::from(*VECTOR_EXP_CYCLES)
        + u64::from(*VECTOR_RECI_CYCLES)
        + 2 * u64::from(*VECTOR_MUL_CYCLES)
        + 2 * u64::from(*SCALAR_INT_BASIC_CYCLES);
    chunks * cycles_per_chunk
}

fn completion_vector_cycles(kind: JobKind, tokens: u64, hidden: u64) -> u64 {
    let hidden_chunks = tokens * hidden.div_ceil(COMPILER_MLEN);
    let cycles_per_chunk = match kind {
        JobKind::Shared => u64::from(*VECTOR_ADD_CYCLES),
        JobKind::Routed => {
            u64::from(*VECTOR_MUL_CYCLES)
                + u64::from(*VECTOR_ADD_CYCLES)
                + u64::from(*SCALAR_INT_BASIC_CYCLES)
        }
    };
    hidden_chunks * cycles_per_chunk
}

fn read_workload(path: &Path) -> GroupedManifest {
    let manifest: GroupedManifest = serde_json::from_slice(
        &std::fs::read(path)
            .unwrap_or_else(|err| panic!("failed to read MKN workload manifest {path:?}: {err}")),
    )
    .unwrap_or_else(|err| panic!("failed to parse MKN workload manifest {path:?}: {err}"));
    assert!(manifest.batch > 0 && manifest.top_k > 0 && manifest.num_experts > 0);
    assert!(
        matches!(manifest.shared_gate.as_str(), "" | "none" | "sigmoid"),
        "shared_gate must be none or sigmoid"
    );
    assert_eq!(
        manifest.group_sizes.values().sum::<u64>(),
        manifest.batch * manifest.top_k,
        "group_sizes must cover every routed token/expert pair"
    );
    for dimension in [manifest.hidden, manifest.routed_intermediate] {
        assert!(
            dimension > 0 && dimension.is_multiple_of(COMPILER_MLEN),
            "model dimensions must be positive and 64-aligned"
        );
    }
    if manifest.shared_experts == 0 {
        assert_eq!(
            manifest.shared_intermediate, 0,
            "shared_intermediate must be zero when shared_experts is zero"
        );
        assert!(
            matches!(manifest.shared_gate.as_str(), "" | "none"),
            "a sigmoid shared gate requires a shared expert"
        );
    } else {
        assert!(
            manifest.shared_intermediate > 0
                && manifest.shared_intermediate.is_multiple_of(COMPILER_MLEN),
            "shared_intermediate must be positive and 64-aligned"
        );
    }
    if !manifest.selected_experts.is_empty() {
        assert!(
            manifest
                .selected_experts
                .iter()
                .all(|expert| manifest.group_sizes.contains_key(&expert.to_string()))
        );
    }
    let _ = tokens_by_expert(&manifest);
    manifest
}

fn tokens_by_expert(manifest: &GroupedManifest) -> BTreeMap<u64, Vec<u64>> {
    let expected_histogram = manifest
        .group_sizes
        .iter()
        .map(|(expert, count)| {
            let expert = expert
                .parse::<u64>()
                .unwrap_or_else(|err| panic!("invalid expert id {expert:?}: {err}"));
            assert!(expert < manifest.num_experts);
            (expert, *count)
        })
        .collect::<BTreeMap<_, _>>();

    if !manifest.token_routes.is_empty() {
        assert_eq!(
            manifest.token_routes.len() as u64,
            manifest.batch,
            "token_routes must contain exactly one record per token"
        );
        let mut result = BTreeMap::<u64, Vec<u64>>::new();
        let mut seen_tokens = BTreeSet::new();
        for token in &manifest.token_routes {
            assert!(token.token_id < manifest.batch && seen_tokens.insert(token.token_id));
            assert_eq!(token.experts.len() as u64, manifest.top_k);
            let mut seen_experts = BTreeSet::new();
            let mut slots = token
                .experts
                .iter()
                .map(|route| route.route_slot)
                .collect::<Vec<_>>();
            slots.sort_unstable();
            assert_eq!(slots, (0..manifest.top_k).collect::<Vec<_>>());
            for route in &token.experts {
                assert!(route.expert_id < manifest.num_experts);
                assert!(seen_experts.insert(route.expert_id));
                result
                    .entry(route.expert_id)
                    .or_default()
                    .push(token.token_id);
            }
        }
        let histogram = result
            .iter()
            .map(|(expert, tokens)| (*expert, tokens.len() as u64))
            .collect::<BTreeMap<_, _>>();
        assert_eq!(
            histogram, expected_histogram,
            "token_routes histogram disagrees with group_sizes"
        );
        for tokens in result.values_mut() {
            tokens.sort_unstable();
        }
        return result;
    }

    // Frozen v1 manifests did not retain token identities.  Reconstruct one
    // deterministic legal bipartite assignment solely for backwards replay;
    // all new v2 captures must provide token_routes explicitly.
    assert!(
        expected_histogram
            .values()
            .all(|count| *count <= manifest.batch),
        "legacy histogram cannot represent unique expert choices per token"
    );
    let mut remaining = expected_histogram.clone();
    let mut result = BTreeMap::<u64, Vec<u64>>::new();
    for token in 0..manifest.batch {
        let mut used = BTreeSet::new();
        for _slot in 0..manifest.top_k {
            let expert = remaining
                .iter()
                .filter(|(expert, count)| **count > 0 && !used.contains(*expert))
                .max_by_key(|(expert, count)| (**count, std::cmp::Reverse(**expert)))
                .map(|(expert, _)| *expert)
                .expect("legacy histogram cannot be assigned without duplicate token experts");
            *remaining.get_mut(&expert).unwrap() -= 1;
            used.insert(expert);
            result.entry(expert).or_default().push(token);
        }
    }
    assert!(remaining.values().all(|count| *count == 0));
    result
}

fn read_architecture(path: &Path) -> MknArchitectureManifest {
    let architecture: MknArchitectureManifest =
        serde_json::from_slice(&std::fs::read(path).unwrap_or_else(|err| {
            panic!("failed to read MKN architecture manifest {path:?}: {err}")
        }))
        .unwrap_or_else(|err| panic!("failed to parse MKN architecture manifest {path:?}: {err}"));
    architecture
        .validate()
        .unwrap_or_else(|err| panic!("invalid MKN architecture: {err}"));
    assert_ne!(
        architecture.mapping, BASELINE_MAPPING,
        "candidate replay requires online_stream_k or dynamic_expert_dispatch"
    );
    architecture
}

fn jobs_from_manifest(manifest: &GroupedManifest) -> Vec<LogicalJob> {
    let routed_tokens = tokens_by_expert(manifest);
    let routed_gate_stride = stored_mx_bytes(manifest.hidden, manifest.routed_intermediate);
    let routed_up_stride = routed_gate_stride;
    let routed_down_stride = stored_mx_bytes(manifest.routed_intermediate, manifest.hidden);
    let routed_gate_table = 0;
    let routed_up_table = routed_gate_table + routed_gate_stride * manifest.num_experts;
    let routed_down_table = routed_up_table + routed_up_stride * manifest.num_experts;
    let shared_projection_gate_stride =
        stored_mx_bytes(manifest.hidden, manifest.shared_intermediate);
    let shared_up_stride = shared_projection_gate_stride;
    let shared_down_stride = stored_mx_bytes(manifest.shared_intermediate, manifest.hidden);
    let shared_projection_gate_table =
        routed_down_table + routed_down_stride * manifest.num_experts;
    let shared_up_table = shared_projection_gate_table + shared_projection_gate_stride;
    let shared_down_table = shared_up_table + shared_up_stride;
    let shared_router_gate_stride = align_up(manifest.hidden * 2, HBM_BURST_BYTES);
    let shared_router_gate_table = shared_down_table + shared_down_stride;

    let mut jobs = Vec::new();
    if manifest.shared_experts > 0 {
        jobs.push(LogicalJob {
            id: jobs.len(),
            kind: JobKind::Shared,
            expert_id: None,
            tokens: manifest.batch,
            token_ids: (0..manifest.batch).collect(),
            projections: [
                Projection {
                    k: manifest.hidden,
                    n: manifest.shared_intermediate,
                    base: shared_projection_gate_table,
                },
                Projection {
                    k: manifest.hidden,
                    n: manifest.shared_intermediate,
                    base: shared_up_table,
                },
                Projection {
                    k: manifest.shared_intermediate,
                    n: manifest.hidden,
                    base: shared_down_table,
                },
            ],
            shared_gate: (manifest.shared_gate == "sigmoid").then(|| SharedGateProjection {
                base: shared_router_gate_table,
                physical_bytes: shared_router_gate_stride,
                vector_cycles: shared_gate_vector_cycles(manifest.batch, manifest.hidden),
            }),
        });
    }

    let mut routed = routed_tokens
        .into_iter()
        .map(|(expert_id, token_ids)| (expert_id, token_ids))
        .collect::<Vec<_>>();
    routed.sort_unstable_by_key(|(expert, tokens)| (std::cmp::Reverse(tokens.len()), *expert));
    if pair_major_jobs() {
        // One job per (expert, token) pair, ordered by (expert, token): every
        // pair reloads its expert's weights and pads its own row block.
        let mut pairs = Vec::new();
        for (expert_id, token_ids) in routed {
            for token in token_ids {
                pairs.push((expert_id, vec![token]));
            }
        }
        pairs.sort_unstable();
        routed = pairs;
    }
    for (expert_id, token_ids) in routed {
        let tokens = token_ids.len() as u64;
        let id = jobs.len();
        jobs.push(LogicalJob {
            id,
            kind: JobKind::Routed,
            expert_id: Some(expert_id),
            tokens,
            token_ids,
            projections: [
                Projection {
                    k: manifest.hidden,
                    n: manifest.routed_intermediate,
                    base: routed_gate_table + expert_id * routed_gate_stride,
                },
                Projection {
                    k: manifest.hidden,
                    n: manifest.routed_intermediate,
                    base: routed_up_table + expert_id * routed_up_stride,
                },
                Projection {
                    k: manifest.routed_intermediate,
                    n: manifest.hidden,
                    base: routed_down_table + expert_id * routed_down_stride,
                },
            ],
            shared_gate: None,
        });
    }
    jobs
}

fn build_panels(
    jobs: &[LogicalJob],
    architecture: &MknArchitectureManifest,
) -> (VecDeque<WeightPanel>, Vec<[usize; 3]>) {
    let mut per_job = vec![VecDeque::new(); jobs.len()];
    let mut totals = vec![[0_usize; 3]; jobs.len()];
    for job in jobs {
        for (projection, tensor) in job.projections.iter().enumerate() {
            let recipe = architecture.recipe_for_job(job);
            let panel_columns =
                recipe.map_or(
                    PANEL_N,
                    |value| {
                        if projection < 2 { value.n_i } else { value.n_o }
                    },
                );
            let k_tile =
                recipe.map_or(
                    tensor.k,
                    |value| {
                        if projection < 2 { value.k_h } else { value.n_i }
                    },
                );
            let m_tile = recipe.map_or(job.tokens, |value| value.m_t);
            let mut n_start = 0;
            while n_start < tensor.n {
                let n_stop = (n_start + panel_columns).min(tensor.n);
                assert!((n_stop - n_start).is_multiple_of(PANEL_N));
                totals[job.id][projection] += 1;
                per_job[job.id].push_back(WeightPanel {
                    id: 0,
                    job_id: job.id,
                    projection,
                    tokens: job.tokens,
                    tensor: tensor.clone(),
                    n_start,
                    n_stop,
                    m_tile,
                    k_tile,
                });
                n_start = n_stop;
            }
        }
    }
    let mut result = VecDeque::new();
    loop {
        let mut moved = false;
        for queue in &mut per_job {
            if let Some(mut panel) = queue.pop_front() {
                panel.id = result.len();
                result.push_back(panel);
                moved = true;
            }
        }
        if !moved {
            break;
        }
    }
    (result, totals)
}

fn append_panel_addresses(panel: &WeightPanel, addresses: &mut Vec<u64>) {
    if inline_scale_layout() {
        // Tile-major, scale-inlined layout.  Tile (n_blk, k_blk) is stored at
        // tensor.base + tile_index * 4608 with n-major ordering so that one
        // 64-column panel is one contiguous run of k_blocks tiles.  Each tile
        // holds eight 576B groups: 512B of elements (8 rows x 64 columns)
        // followed by the 64B of scales for those rows.
        let k_blocks_total = panel.tensor.k / COMPILER_MLEN;
        for n_start in (panel.n_start..panel.n_stop).step_by(PANEL_N as usize) {
            let n_blk = n_start / PANEL_N;
            for k_blk in 0..k_blocks_total {
                let tile_base = panel.tensor.base + (n_blk * k_blocks_total + k_blk) * INLINE_TILE_BYTES;
                assert!(tile_base.is_multiple_of(HBM_BURST_BYTES));
                for group in 0..(COMPILER_MLEN / INLINE_GROUP_ROWS) {
                    let group_base = tile_base + group * INLINE_GROUP_BYTES;
                    for burst in 0..(INLINE_GROUP_BYTES / HBM_BURST_BYTES) {
                        addresses.push(group_base + burst * HBM_BURST_BYTES);
                    }
                }
            }
        }
        return;
    }
    let scale_base = panel.tensor.base + panel.tensor.k * panel.tensor.n;
    for n_start in (panel.n_start..panel.n_stop).step_by(PANEL_N as usize) {
        for k_start in (0..panel.tensor.k).step_by(COMPILER_MLEN as usize) {
            for row_offset in 0..COMPILER_MLEN {
                let logical = (k_start + row_offset) * panel.tensor.n + n_start;
                let element_addr = panel.tensor.base + logical;
                assert!(element_addr.is_multiple_of(HBM_BURST_BYTES));
                addresses.push(element_addr);
                let scale_addr = scale_base + logical / MX_BLOCK;
                addresses.push(scale_addr / HBM_BURST_BYTES * HBM_BURST_BYTES);
            }
        }
    }
}

fn canonical_hbm_address_digest(jobs: &[LogicalJob], panels: &VecDeque<WeightPanel>) -> String {
    let mut addresses = Vec::new();
    for job in jobs {
        if let Some(gate) = &job.shared_gate {
            for offset in (0..gate.physical_bytes).step_by(HBM_BURST_BYTES as usize) {
                addresses.push(gate.base + offset);
            }
        }
    }
    for panel in panels {
        append_panel_addresses(panel, &mut addresses);
    }
    // Recipe-dependent panel grouping changes request order but not the
    // physical multiset.  Sorting makes this equivalence digest invariant to
    // legal scheduling/prefetch order while retaining duplicate scale reads.
    addresses.sort_unstable();
    let mut hasher = Sha256::new();
    for address in addresses {
        hasher.update(address.to_le_bytes());
    }
    format!("{:x}", hasher.finalize())
}

async fn issue_addresses(hbm: &Arc<dyn ErasedMemoryModel>, addresses: &mut Vec<u64>) {
    async fn issue_one(hbm: Arc<dyn ErasedMemoryModel>, address: u64) {
        let _ = hbm.read(address).await;
    }

    let mut source = std::mem::take(addresses).into_iter();
    let mut pending = FuturesUnordered::new();
    for address in source.by_ref().take(HBM_MAX_IN_FLIGHT) {
        pending.push(issue_one(hbm.clone(), address));
    }
    while pending.next().await.is_some() {
        if let Some(address) = source.next() {
            pending.push(issue_one(hbm.clone(), address));
        }
    }
}

#[derive(Clone, Debug)]
struct Task {
    panel_id: usize,
    core_id: usize,
    mode: DispatchMode,
    stolen: bool,
    contributions: [(usize, u64); MAX_TASK_OUTPUTS],
    contribution_count: usize,
    useful_atoms: u64,
    issued_atoms: u64,
    cycles: u64,
}

#[derive(Debug)]
struct PanelState {
    panel: WeightPanel,
    loaded: bool,
    bank_id: usize,
    next_k_by_output: Vec<u64>,
    output_owner: Vec<Option<usize>>,
    in_flight_tasks: u64,
    output_remaining: Vec<u64>,
    output_participants: Vec<BTreeSet<usize>>,
}

impl PanelState {
    fn new(panel: WeightPanel, bank_id: usize) -> Self {
        let outputs = panel.output_count() as usize;
        Self {
            output_remaining: vec![panel.k_blocks(); outputs],
            output_participants: vec![BTreeSet::new(); outputs],
            next_k_by_output: vec![0; outputs],
            output_owner: vec![None; outputs],
            panel,
            loaded: false,
            bank_id,
            in_flight_tasks: 0,
        }
    }

    fn remaining_atoms(&self) -> u64 {
        self.next_k_by_output
            .iter()
            .map(|next_k| self.panel.k_blocks() - next_k)
            .sum()
    }

    fn all_work_assigned(&self) -> bool {
        self.next_k_by_output
            .iter()
            .all(|next_k| *next_k == self.panel.k_blocks())
    }

    fn width(&self) -> u64 {
        self.panel.n_stop - self.panel.n_start
    }

    fn output_index(&self, token: u64, n: u64) -> usize {
        (token * self.width() + n) as usize
    }

    fn weighted_owner(position: u64, total: u64, weights: &[u64]) -> usize {
        let weight_sum = weights.iter().sum::<u64>();
        let target = position * weight_sum / total.max(1);
        let mut prefix = 0;
        for (index, weight) in weights.iter().enumerate() {
            prefix += *weight;
            if target < prefix {
                return index;
            }
        }
        weights.len() - 1
    }

    fn statically_owned(
        &self,
        token: u64,
        n: u64,
        k_start: u64,
        core_id: usize,
        cores: &[MknCore],
        mode: DispatchMode,
    ) -> bool {
        match mode {
            DispatchMode::MSplit => {
                let weights = cores.iter().map(|core| core.m).collect::<Vec<_>>();
                Self::weighted_owner(token, self.panel.tokens, &weights) == core_id
            }
            DispatchMode::ColumnUpRowDown if self.panel.projection < 2 => {
                let weights = cores.iter().map(|core| core.n).collect::<Vec<_>>();
                Self::weighted_owner(n, self.width(), &weights) == core_id
            }
            DispatchMode::KSplit | DispatchMode::ColumnUpRowDown => {
                let weights = cores
                    .iter()
                    .map(|core| core.k / COMPILER_MLEN)
                    .collect::<Vec<_>>();
                Self::weighted_owner(k_start, self.panel.k_blocks(), &weights) == core_id
            }
            _ => true,
        }
    }

    fn eligible_start(
        &self,
        core_id: usize,
        cores: &[MknCore],
        mode: DispatchMode,
        prefer_locality: bool,
        allow_steal: bool,
    ) -> Option<(usize, bool)> {
        let mut fallback = None;
        for index in 0..self.next_k_by_output.len() {
            if self.next_k_by_output[index] == self.panel.k_blocks() {
                continue;
            }
            let token = index as u64 / self.width();
            let n = index as u64 % self.width();
            let statically_owned =
                self.statically_owned(token, n, self.next_k_by_output[index], core_id, cores, mode);
            if !statically_owned && !allow_steal {
                continue;
            }
            match self.output_owner[index] {
                Some(owner) if owner == core_id && statically_owned => {
                    return Some((index, false));
                }
                Some(owner) if allow_steal => {
                    fallback.get_or_insert((index, owner != core_id || !statically_owned));
                }
                Some(_) => {}
                None if !prefer_locality => return Some((index, !statically_owned)),
                None => {
                    fallback.get_or_insert((index, !statically_owned));
                }
            };
        }
        fallback
    }

    fn rectangle_compatible(
        &self,
        output_coordinate: (u64, u64),
        k_start: u64,
        core_id: usize,
        cores: &[MknCore],
        mode: DispatchMode,
        allow_steal: bool,
    ) -> bool {
        let (token, n) = output_coordinate;
        let index = self.output_index(token, n);
        self.next_k_by_output[index] == k_start
            && (self.statically_owned(token, n, k_start, core_id, cores, mode) || allow_steal)
            && match self.output_owner[index] {
                None => true,
                Some(owner) => owner == core_id || allow_steal,
            }
    }

    fn assign_rectangular_task(
        &mut self,
        core_id: usize,
        cores: &[MknCore],
        mode: DispatchMode,
        prefer_locality: bool,
        allow_steal: bool,
    ) -> Option<Task> {
        let core = &cores[core_id];
        let (output_index, stolen) =
            self.eligible_start(core_id, cores, mode, prefer_locality, allow_steal)?;
        let token_start = output_index as u64 / self.width();
        let n_start = output_index as u64 % self.width();
        let k_start = self.next_k_by_output[output_index];
        let k_extent = (core.k / COMPILER_MLEN)
            .min(self.panel.k_tile / COMPILER_MLEN)
            .min(self.panel.k_blocks() - k_start);

        let mut n_extent = 1;
        while n_extent < core.n && n_start + n_extent < self.width() {
            if !self.rectangle_compatible(
                (token_start, n_start + n_extent),
                k_start,
                core_id,
                cores,
                mode,
                allow_steal,
            ) {
                break;
            }
            n_extent += 1;
        }
        let mut token_extent = 1;
        while token_extent < core.m
            && token_extent < self.panel.m_tile
            && token_start + token_extent < self.panel.tokens
        {
            let compatible = (n_start..n_start + n_extent).all(|n| {
                self.rectangle_compatible(
                    (token_start + token_extent, n),
                    k_start,
                    core_id,
                    cores,
                    mode,
                    allow_steal,
                )
            });
            if !compatible {
                break;
            }
            token_extent += 1;
        }

        let mut contributions = [(0, 0); MAX_TASK_OUTPUTS];
        let mut contribution_count = 0;
        for token in token_start..token_start + token_extent {
            for n in n_start..n_start + n_extent {
                let output = self.output_index(token, n);
                self.next_k_by_output[output] = k_start + k_extent;
                self.output_owner[output].get_or_insert(core_id);
                contributions[contribution_count] = (output, k_extent);
                contribution_count += 1;
            }
        }
        assert!(contribution_count <= MAX_TASK_OUTPUTS);
        let useful_atoms = token_extent * n_extent * k_extent;
        Some(Task {
            panel_id: self.panel.id,
            core_id,
            mode,
            stolen,
            contributions,
            contribution_count,
            useful_atoms,
            issued_atoms: core.atom_capacity(),
            cycles: core.tile_cycles(),
        })
    }
}

