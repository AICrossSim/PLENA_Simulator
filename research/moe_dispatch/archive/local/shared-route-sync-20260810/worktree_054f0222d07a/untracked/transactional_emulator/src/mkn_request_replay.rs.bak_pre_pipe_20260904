#[derive(Clone, Debug, Deserialize, Serialize)]
pub(crate) struct DynamicSchedulerConfig {
    #[serde(default = "default_scheduler_policy")]
    pub(crate) policy: String,
    #[serde(default = "default_allowed_modes")]
    pub(crate) allowed_modes: Vec<String>,
    #[serde(default = "default_cold_expert_max_tokens")]
    pub(crate) cold_expert_max_tokens: u64,
    #[serde(default = "default_hot_expert_min_tokens")]
    pub(crate) hot_expert_min_tokens: u64,
    #[serde(default = "default_prefer_output_locality")]
    pub(crate) prefer_output_locality: bool,
    #[serde(default = "default_mode_switch_cycles")]
    pub(crate) mode_switch_cycles: u64,
}

impl Default for DynamicSchedulerConfig {
    fn default() -> Self {
        Self {
            policy: default_scheduler_policy(),
            allowed_modes: default_allowed_modes(),
            cold_expert_max_tokens: default_cold_expert_max_tokens(),
            hot_expert_min_tokens: default_hot_expert_min_tokens(),
            prefer_output_locality: default_prefer_output_locality(),
            mode_switch_cycles: default_mode_switch_cycles(),
        }
    }
}

impl DynamicSchedulerConfig {
    fn allows(&self, mode: DispatchMode) -> bool {
        self.allowed_modes
            .iter()
            .any(|candidate| candidate == mode.name())
    }

    fn validate(&self) -> Result<(), String> {
        if self.policy != "earliest_finish_work_stealing" {
            return Err(format!("unsupported scheduler policy {}", self.policy));
        }
        if self.allowed_modes.is_empty() {
            return Err("scheduler allowed_modes must not be empty".to_string());
        }
        for mode in &self.allowed_modes {
            DispatchMode::parse(mode)
                .ok_or_else(|| format!("unsupported dynamic mapping mode {mode}"))?;
        }
        if self.hot_expert_min_tokens <= self.cold_expert_max_tokens {
            return Err("hot_expert_min_tokens must exceed cold_expert_max_tokens".to_string());
        }
        if self.mode_switch_cycles > 1024 {
            return Err("mode_switch_cycles must be <=1024".to_string());
        }
        Ok(())
    }
}

