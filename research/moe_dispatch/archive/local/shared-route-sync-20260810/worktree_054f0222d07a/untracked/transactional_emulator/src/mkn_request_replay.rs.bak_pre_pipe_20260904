            assert!(comparison.equal_pe_count_passed);
            assert!(comparison.equal_global_sram_contract_passed);
            assert_eq!(comparison.baseline.completed_jobs, 2);
            assert_eq!(comparison.candidate.completed_jobs, 2);
            assert!(comparison.baseline.all_atoms_completed);
            assert!(comparison.candidate.all_atoms_completed);
            assert!(comparison.baseline.executor_drain_passed);
            assert!(comparison.candidate.executor_drain_passed);
            digests.push(serde_json::to_vec(&comparison).unwrap());
        }
        assert!(digests.iter().all(|digest| digest == &digests[0]));
    }

    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
    async fn dynamic_dispatch_maps_shared_and_cold_jobs_without_changing_hbm_bytes() {
        let jobs = jobs_from_manifest(&fixture_manifest());
        let mut architecture = dynamic_two_core();
        architecture.scheduler.mode_switch_cycles = 8;
        let comparison = compare_once(jobs, architecture, None).await;
        assert!(comparison.hbm_byte_equality_passed);
        assert_eq!(
            comparison.candidate.job_mapping_modes["shared:0"],
            DispatchMode::KSplit.name()
        );
        assert_eq!(
            comparison.candidate.job_mapping_modes["routed:1"],
            DispatchMode::ExpertSingleCore.name()
        );
        assert!(comparison.candidate.dynamic_dispatches > 0);
        assert!(comparison.candidate.mode_switch_events > 0);
        assert_eq!(
            comparison.candidate.mode_switch_core_cycles,
            comparison.candidate.mode_switch_events * 8
        );
        assert!(comparison.candidate.activation_busy_cycles > 0);
        assert_eq!(
            comparison.baseline.activation_vector_cycles,
            comparison.candidate.activation_vector_cycles
        );
        assert!(comparison.candidate.executor_drain_passed);
    }
