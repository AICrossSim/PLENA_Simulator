    hidden: u64,
}

fn select_job_mode(architecture: &MknArchitectureManifest, job: &LogicalJob) -> DispatchMode {
    if architecture.mapping == BASELINE_MAPPING {
        return DispatchMode::ExpertSingleCore;
    }
    if architecture.mapping == STREAM_K_MAPPING {
        return DispatchMode::StreamK;
    }
    if let Some(recipe) = architecture.recipe_for_job(job) {
        if recipe.mapping_mode != DYNAMIC_MAPPING {
            let mode = DispatchMode::parse(&recipe.mapping_mode)
                .unwrap_or_else(|| panic!("recipe {} has unsupported mapping mode", recipe.id));
            assert!(architecture.scheduler.allows(mode));
            return mode;
        }
    }

    let scheduler = &architecture.scheduler;
    if scheduler.allowed_modes.len() == 1 {
        return DispatchMode::parse(&scheduler.allowed_modes[0]).unwrap();
    }
    let preferences: &[DispatchMode] = if job.tokens >= scheduler.hot_expert_min_tokens {
        &[
            DispatchMode::MSplit,
            DispatchMode::StreamK,
            DispatchMode::ColumnUpRowDown,
            DispatchMode::KSplit,
            DispatchMode::ExpertSingleCore,
        ]
    } else if job.kind == JobKind::Shared {
        &[
            DispatchMode::KSplit,
            DispatchMode::StreamK,
            DispatchMode::ColumnUpRowDown,
            DispatchMode::MSplit,
            DispatchMode::ExpertSingleCore,
        ]
    } else if job.tokens <= scheduler.cold_expert_max_tokens {
        &[
            DispatchMode::ExpertSingleCore,
            DispatchMode::StreamK,
            DispatchMode::KSplit,
            DispatchMode::ColumnUpRowDown,
            DispatchMode::MSplit,
        ]
    } else {
        &[
            DispatchMode::ColumnUpRowDown,
            DispatchMode::StreamK,
            DispatchMode::KSplit,
            DispatchMode::MSplit,
            DispatchMode::ExpertSingleCore,
        ]
    };
    preferences
        .iter()
        .copied()
        .find(|mode| scheduler.allows(*mode))
        .expect("validated scheduler must allow at least one mapping mode")
}

struct DynamicExpertDispatcher {
    architecture: MknArchitectureManifest,
    sender: mpsc::UnboundedSender<Event>,
    job_schedules: Vec<JobSchedule>,
    pending_panels: VecDeque<WeightPanel>,
    panel_totals: Vec<[usize; 3]>,
    panel_completed: Vec<[usize; 3]>,
    panels: BTreeMap<usize, PanelState>,
    live_panels: usize,
    max_live_panels: usize,
    total_panels: usize,
    completed_panels: usize,
    free_cores: BTreeSet<usize>,
    free_weight_banks: BTreeSet<usize>,
    reducer_queue: VecDeque<Reduction>,
    reducer_busy: bool,
    vector_queue: VecDeque<VectorWork>,
    vector_busy: bool,
    combine_queue: VecDeque<CombineWork>,
    combine_busy: bool,
    token_remaining_contributions: Vec<u64>,
    token_total_contributions: Vec<u64>,
    completed_tokens: usize,
    completed_jobs: usize,
    next_sequence: u64,
    core_busy_cycles: Vec<u64>,
    core_macro_tiles: Vec<u64>,
    core_last_completion_cycles: Vec<u64>,
    core_last_modes: Vec<Option<DispatchMode>>,
    switching_cores: BTreeSet<usize>,
    mode_switch_events: u64,
    mode_switch_core_cycles: u64,
    dispatch_mode_macro_tiles: BTreeMap<String, u64>,
    dynamic_dispatches: u64,
    work_steal_events: u64,
    useful_macs: u64,
    issued_macs: u64,
    reducer_busy_cycles: u64,
    reducer_queue_wait_cycles: u64,
    reduction_output_elements: u64,
    reduction_add_elements: u64,
    interconnect_bytes: u64,
    activation_busy_cycles: u64,
    completion_busy_cycles: u64,
    combine_busy_cycles: u64,
    combine_queue_wait_cycles: u64,
    combine_add_elements: u64,
    scheduled_events: BTreeMap<(u64, u64), Event>,
    current_cycle: u64,
}

impl DynamicExpertDispatcher {
    fn new(
        architecture: MknArchitectureManifest,
        jobs: &[LogicalJob],
        panels: VecDeque<WeightPanel>,
        panel_totals: Vec<[usize; 3]>,
        sender: mpsc::UnboundedSender<Event>,
    ) -> Self {
        let cores = architecture.cores.len();
        let total_panels = panels.len();
        let job_schedules = jobs
            .iter()
            .map(|job| JobSchedule {
                label: format!(
                    "{}:{}",
                    match job.kind {
                        JobKind::Shared => "shared",
                        JobKind::Routed => "routed",
                    },
                    job.expert_id.unwrap_or(0)
                ),
                mode: select_job_mode(&architecture, job),
                affinity: None,
                shared_gate_ready: job.shared_gate.is_none(),
                activation_ready: false,
                activation_queued: false,
                down_complete: false,
                completion_queued: false,
                activation_cycles: activation_vector_cycles(job.tokens, job.projections[0].n),
                completion_vector_cycles: job
                    .shared_gate
                    .as_ref()
                    .map_or(0, |gate| gate.vector_cycles)
                    + completion_vector_cycles(job.kind, job.tokens, job.projections[2].n),
                token_ids: job.token_ids.clone(),
                hidden: job.projections[2].n,
            })
            .collect();
        let token_count = jobs
            .iter()
            .flat_map(|job| job.token_ids.iter().copied())
            .max()
            .map_or(0, |maximum| maximum as usize + 1);
        let mut token_total_contributions = vec![0_u64; token_count];
        for job in jobs {
            for token in &job.token_ids {
                token_total_contributions[*token as usize] += 1;
            }
        }
        let weight_buffer_banks = architecture.weight_buffer_banks;
        Self {
            architecture,
            sender,
            job_schedules,
            pending_panels: panels,
            panel_completed: vec![[0; 3]; panel_totals.len()],
            panel_totals,
            panels: BTreeMap::new(),
            live_panels: 0,
            max_live_panels: 0,
            total_panels,
            completed_panels: 0,
            free_cores: (0..cores).collect(),
            free_weight_banks: (0..weight_buffer_banks).collect(),
            reducer_queue: VecDeque::new(),
            reducer_busy: false,
            vector_queue: VecDeque::new(),
            vector_busy: false,
            combine_queue: VecDeque::new(),
            combine_busy: false,
            token_remaining_contributions: token_total_contributions.clone(),
            token_total_contributions,
            completed_tokens: 0,
            completed_jobs: 0,
            next_sequence: 0,
            core_busy_cycles: vec![0; cores],
            core_macro_tiles: vec![0; cores],
            core_last_completion_cycles: vec![0; cores],
            core_last_modes: vec![None; cores],
            switching_cores: BTreeSet::new(),
            mode_switch_events: 0,
            mode_switch_core_cycles: 0,
            dispatch_mode_macro_tiles: BTreeMap::new(),
            dynamic_dispatches: 0,
            work_steal_events: 0,
            useful_macs: 0,
            issued_macs: 0,
            reducer_busy_cycles: 0,
            reducer_queue_wait_cycles: 0,
            reduction_output_elements: 0,
            reduction_add_elements: 0,
            interconnect_bytes: 0,
            activation_busy_cycles: 0,
            completion_busy_cycles: 0,
            combine_busy_cycles: 0,
            combine_queue_wait_cycles: 0,
            combine_add_elements: 0,
            scheduled_events: BTreeMap::new(),
            current_cycle: 0,
        }
    }

    fn set_current_cycle(&mut self, cycle: u64) {
        self.current_cycle = cycle;
    }

    fn sequence(&mut self) -> u64 {
        self.next_sequence += 1;
        self.next_sequence
    }

    fn schedule_event(&mut self, event: Event) {
        assert!(self.scheduled_events.insert(event.key(), event).is_none());
    }

    fn drain_scheduled_events(&mut self, events: &mut BTreeMap<(u64, u64), Event>) {
        while let Some((key, event)) = self.scheduled_events.pop_first() {
            assert!(events.insert(key, event).is_none());
        }
    }

    fn launch_shared_gates(&mut self, hbm: &Arc<dyn ErasedMemoryModel>, jobs: &[LogicalJob]) {
        for job in jobs {
            let Some(gate) = job.shared_gate.clone() else {
                continue;
            };
            let sequence = self.sequence();
            launch_shared_gate_transfer(hbm.clone(), job.id, gate, sequence, self.sender.clone());
        }
    }

    fn down_ready(&self, job: usize) -> bool {
        self.panel_completed[job][0] == self.panel_totals[job][0]
            && self.panel_completed[job][1] == self.panel_totals[job][1]
    }

    fn launch_pending(&mut self, hbm: &Arc<dyn ErasedMemoryModel>) {
        while self.live_panels < self.architecture.buffer_depth {
            let Some(panel) = self.pending_panels.pop_front() else {
                break;
            };
            let sequence = self.sequence();
            launch_panel_transfer(hbm.clone(), panel.clone(), sequence, self.sender.clone());
            assert!(
                self.panels
                    .insert(
                        panel.id,
                        PanelState::new(
                            panel.clone(),
                            panel.id % self.architecture.weight_buffer_banks,
                        ),
                    )
                    .is_none()
            );
            self.live_panels += 1;
            self.max_live_panels = self.max_live_panels.max(self.live_panels);
        }
    }

    fn panel_dependency_ready(&self, state: &PanelState) -> bool {
        state.panel.projection != 2 || self.job_schedules[state.panel.job_id].activation_ready
    }

    fn core_can_take_job(&self, core_id: usize, job_id: usize) -> bool {
        let schedule = &self.job_schedules[job_id];
        schedule.mode != DispatchMode::ExpertSingleCore
            || schedule.affinity.is_none()
            || schedule.affinity == Some(core_id)
    }

    fn mode_supports_steal(mode: DispatchMode) -> bool {
        matches!(
            mode,
            DispatchMode::KSplit | DispatchMode::ColumnUpRowDown | DispatchMode::StreamK
        )
    }

    fn find_dispatch_pair(
        &self,
        allow_steal: bool,
        ignore_bank_ports: bool,
    ) -> Option<(usize, usize)> {
        let mut best = None;
        for core_id in self.free_cores.iter().copied() {
            let core = &self.architecture.cores[core_id];
            for (panel_id, state) in &self.panels {
                if !state.loaded
                    || state.remaining_atoms() == 0
                    || !self.panel_dependency_ready(state)
                    || !self.core_can_take_job(core_id, state.panel.job_id)
                    || (!ignore_bank_ports && !self.free_weight_banks.contains(&state.bank_id))
                {
                    continue;
                }
                let mode = self.job_schedules[state.panel.job_id].mode;
                if allow_steal && !Self::mode_supports_steal(mode) {
                    continue;
                }
                if state
                    .eligible_start(
                        core_id,
                        &self.architecture.cores,
                        mode,
                        self.architecture.scheduler.prefer_output_locality,
                        allow_steal,
                    )
                    .is_none()
                {
                    continue;
                }
                let useful_capacity = state.panel.tokens.min(core.m)
                    * state.width().min(core.n)
                    * state.panel.k_blocks().min(core.k / COMPILER_MLEN);
                let score = (
                    state.remaining_atoms(),
                    useful_capacity * 1_000_000 / core.tile_cycles().max(1),
                    std::cmp::Reverse(*panel_id),
                    std::cmp::Reverse(core_id),
                );
                if best
                    .as_ref()
                    .is_none_or(|(best_score, _, _)| score > *best_score)
                {
                    best = Some((score, core_id, *panel_id));
                }
            }
        }
        best.map(|(_, core_id, panel_id)| (core_id, panel_id))
    }

    fn dispatch(&mut self) {
        loop {
            let (allow_steal, pair) = if let Some(pair) = self.find_dispatch_pair(false, false) {
                (false, pair)
            } else if let Some(pair) = self.find_dispatch_pair(true, false) {
                (true, pair)
            } else {
                break;
            };
            let (core_id, panel_id) = pair;
            let job_id = self.panels[&panel_id].panel.job_id;
            let mode = self.job_schedules[job_id].mode;
            if self.architecture.scheduler.mode_switch_cycles > 0
                && self.core_last_modes[core_id].is_some_and(|previous| previous != mode)
            {
                assert!(self.free_cores.remove(&core_id));
                assert!(self.switching_cores.insert(core_id));
                self.core_last_modes[core_id] = Some(mode);
                self.mode_switch_events += 1;
                self.mode_switch_core_cycles += self.architecture.scheduler.mode_switch_cycles;
                let sequence = self.sequence();
                self.schedule_event(Event::CoreModeSwitchDone {
                    sequence,
                    cycle: self.current_cycle + self.architecture.scheduler.mode_switch_cycles,
                    core_id,
                });
                continue;
            }
            self.core_last_modes[core_id] = Some(mode);
            if mode == DispatchMode::ExpertSingleCore
                && self.job_schedules[job_id].affinity.is_none()
            {
                self.job_schedules[job_id].affinity = Some(core_id);
            }
            assert!(self.free_cores.remove(&core_id));
            let bank_id = self.panels[&panel_id].bank_id;
            assert!(self.free_weight_banks.remove(&bank_id));
            let operand_load_cycles = self.architecture.cores[core_id]
                .m
                .max(self.architecture.cores[core_id].n);
            let state = self.panels.get_mut(&panel_id).unwrap();
            let task = state
                .assign_rectangular_task(
                    core_id,
                    &self.architecture.cores,
                    mode,
                    self.architecture.scheduler.prefer_output_locality,
                    allow_steal,
                )
                .expect("selected core/panel pair must remain dispatchable");
            state.in_flight_tasks += 1;
            self.core_busy_cycles[core_id] += task.cycles;
            self.core_macro_tiles[core_id] += 1;
            *self
                .dispatch_mode_macro_tiles
                .entry(task.mode.name().to_string())
                .or_default() += 1;
            self.dynamic_dispatches += 1;
            if task.stolen {
                self.work_steal_events += 1;
            }
            self.useful_macs += task.useful_atoms * COMPILER_MLEN;
            self.issued_macs += task.issued_atoms * COMPILER_MLEN;
            let bank_sequence = self.sequence();
            let now = self.current_cycle;
            self.schedule_event(Event::WeightBankReleased {
                sequence: bank_sequence,
                cycle: now + operand_load_cycles,
                bank_id,
            });
            let completion_sequence = self.sequence();
            self.schedule_event(Event::CoreDone {
                sequence: completion_sequence,
                cycle: now + task.cycles,
                task,
            });
        }
    }

    fn start_reducer(&mut self) {
        if self.reducer_busy {
            return;
        }
        let Some(reduction) = self.reducer_queue.pop_front() else {
            return;
        };
        self.reducer_busy = true;
        self.reducer_queue_wait_cycles += self.current_cycle.saturating_sub(reduction.ready_cycle);
        self.reducer_busy_cycles += reduction.cycles;
        let sequence = self.sequence();
        self.schedule_event(Event::ReductionDone {
            sequence,
            cycle: self.current_cycle + reduction.cycles,
            reduction,
        });
    }

    fn start_vector(&mut self) {
        if self.vector_busy {
            return;
        }
        let Some(work) = self.vector_queue.pop_front() else {
            return;
        };
        self.vector_busy = true;
        match work.kind {
            VectorWorkKind::Activation => self.activation_busy_cycles += work.cycles,
            VectorWorkKind::Completion => self.completion_busy_cycles += work.cycles,
        }
        let cycles = work.cycles;
        let sequence = self.sequence();
        self.schedule_event(Event::VectorDone {
            sequence,
            cycle: self.current_cycle + cycles,
            work,
        });
    }

    fn start_combine(&mut self) {
        if self.combine_busy {
            return;
        }
        let Some(work) = self.combine_queue.pop_front() else {
            return;
        };
        self.combine_busy = true;
        self.combine_busy_cycles += work.cycles;
        self.combine_queue_wait_cycles += self.current_cycle.saturating_sub(work.ready_cycle);
        let sequence = self.sequence();
        self.schedule_event(Event::CombineDone {
            sequence,
            cycle: self.current_cycle + work.cycles,
            work,
        });
    }

    fn retire_token_contribution(&mut self, token_id: usize, hidden: u64) {
        assert!(self.token_remaining_contributions[token_id] > 0);
        self.token_remaining_contributions[token_id] -= 1;
        if self.token_remaining_contributions[token_id] != 0 {
            return;
        }
        let parts = self.token_total_contributions[token_id];
        let levels = if parts <= 1 {
            0
        } else {
            parts.next_power_of_two().ilog2() as u64
        };
        let cycles = hidden.div_ceil(REDUCTION_WIDTH) * levels;
        let add_elements = hidden * parts.saturating_sub(1);
        if cycles == 0 {
            self.combine_add_elements += add_elements;
            self.completed_tokens += 1;
            return;
        }
        self.combine_queue.push_back(CombineWork {
            token_id,
            cycles,
            add_elements,
            ready_cycle: self.current_cycle,
        });
        self.start_combine();
    }

    fn finish_panel(&mut self, panel_id: usize) {
        let state = self.panels.remove(&panel_id).unwrap();
        assert!(state.all_work_assigned());
        assert_eq!(state.in_flight_tasks, 0);
        assert!(
            state
                .output_remaining
                .iter()
                .all(|remaining| *remaining == 0)
        );
        self.panel_completed[state.panel.job_id][state.panel.projection] += 1;
        self.completed_panels += 1;
        self.live_panels -= 1;
        if state.panel.projection < 2 {
            self.maybe_queue_activation(state.panel.job_id);
        }
        if state.panel.projection == 2
            && self.panel_completed[state.panel.job_id][2]
                == self.panel_totals[state.panel.job_id][2]
        {
            self.job_schedules[state.panel.job_id].down_complete = true;
            self.maybe_queue_completion(state.panel.job_id);
        }
    }

    fn maybe_queue_activation(&mut self, job_id: usize) {
        if !self.down_ready(job_id) || self.job_schedules[job_id].activation_queued {
            return;
        }
        let schedule = &mut self.job_schedules[job_id];
        schedule.activation_queued = true;
        self.vector_queue.push_back(VectorWork {
            kind: VectorWorkKind::Activation,
            job_id,
            cycles: schedule.activation_cycles,
        });
        self.start_vector();
    }

    fn maybe_queue_completion(&mut self, job_id: usize) {
        let schedule = &mut self.job_schedules[job_id];
        if schedule.down_complete && schedule.shared_gate_ready && !schedule.completion_queued {
            schedule.completion_queued = true;
            self.vector_queue.push_back(VectorWork {
                kind: VectorWorkKind::Completion,
                job_id,
                cycles: COMPLETION_CYCLES + schedule.completion_vector_cycles,
            });
            self.start_vector();
        }
    }

    fn queue_panel_reduction(&mut self, panel_id: usize, cycle: u64) {
        let state = self.panels.get(&panel_id).unwrap();
        let mut by_parts = BTreeMap::<u64, u64>::new();
        for participants in &state.output_participants {
            if participants.len() > 1 {
                *by_parts.entry(participants.len() as u64).or_default() += 1;
            }
        }
        let mut cycles = 0;
        let mut bytes = 0;
        let mut elements = 0;
        let mut add_elements = 0;
        for (parts, count) in by_parts {
            let levels = parts.next_power_of_two().ilog2() as u64;
            cycles += count.div_ceil(REDUCTION_WIDTH) * levels;
            bytes += count * 2 * (parts - 1);
            elements += count;
            add_elements += count * (parts - 1);
        }
        if cycles == 0 {
            self.finish_panel(panel_id);
        } else {
            cycles += REDUCTION_SYNC_CYCLES;
            self.reducer_queue.push_back(Reduction {
                panel_id,
                cycles,
                bytes,
                elements,
                add_elements,
                ready_cycle: cycle,
            });
            self.start_reducer();
        }
    }

    fn handle_core_done(&mut self, cycle: u64, task: Task) {
        assert!(self.free_cores.insert(task.core_id));
        self.core_last_completion_cycles[task.core_id] = cycle;
        let state = self.panels.get_mut(&task.panel_id).unwrap();
        state.in_flight_tasks -= 1;
        for (output, atoms) in &task.contributions[..task.contribution_count] {
            let output = *output;
            let atoms = *atoms;
            assert!(state.output_remaining[output] >= atoms);
            state.output_remaining[output] -= atoms;
            state.output_participants[output].insert(task.core_id);
        }
        if state.all_work_assigned() && state.in_flight_tasks == 0 {
            self.queue_panel_reduction(task.panel_id, cycle);
        }
    }

    fn handle(&mut self, event: Event) {
        match event {
            Event::PanelReady { panel_id, .. } => {
                self.panels.get_mut(&panel_id).unwrap().loaded = true;
            }
            Event::CoreDone { cycle, task, .. } => self.handle_core_done(cycle, task),
            Event::WeightBankReleased { bank_id, .. } => {
                assert!(self.free_weight_banks.insert(bank_id));
            }
            Event::CoreModeSwitchDone { core_id, .. } => {
                assert!(self.switching_cores.remove(&core_id));
                assert!(self.free_cores.insert(core_id));
            }
            Event::SharedGateReady { job_id, .. } => {
                self.job_schedules[job_id].shared_gate_ready = true;
                self.maybe_queue_completion(job_id);
            }
            Event::ReductionDone { reduction, .. } => {
                assert!(self.reducer_busy);
                self.reducer_busy = false;
                self.reduction_output_elements += reduction.elements;
                self.reduction_add_elements += reduction.add_elements;
                self.interconnect_bytes += reduction.bytes;
                self.finish_panel(reduction.panel_id);
                self.start_reducer();
            }
            Event::VectorDone { work, .. } => {
                assert!(self.vector_busy);
                self.vector_busy = false;
                match work.kind {
                    VectorWorkKind::Activation => {
                        assert!(self.down_ready(work.job_id));
                        self.job_schedules[work.job_id].activation_ready = true;
                    }
                    VectorWorkKind::Completion => {
                        assert_eq!(
                            self.panel_completed[work.job_id][2],
                            self.panel_totals[work.job_id][2]
                        );
                        self.completed_jobs += 1;
                        let token_ids = self.job_schedules[work.job_id].token_ids.clone();
                        let hidden = self.job_schedules[work.job_id].hidden;
                        for token in token_ids {
                            self.retire_token_contribution(token as usize, hidden);
                        }
                    }
                }
                self.start_vector();
            }
            Event::CombineDone { work, .. } => {
                assert!(self.combine_busy);
                self.combine_busy = false;
                assert_eq!(self.token_remaining_contributions[work.token_id], 0);
                self.combine_add_elements += work.add_elements;
                self.completed_tokens += 1;
                self.start_combine();
            }
        }
    }

    fn all_cores_free(&self) -> bool {
        self.free_cores.len() == self.architecture.cores.len()
    }

    fn has_compute_inflight(&self) -> bool {
        self.free_cores.len() + self.switching_cores.len() < self.architecture.cores.len()
    }

    fn all_weight_banks_free(&self) -> bool {
        self.free_weight_banks.len() == self.architecture.weight_buffer_banks
    }

    fn has_loaded_ready_work(&self) -> bool {
        self.panels.values().any(|state| {
            state.loaded && state.remaining_atoms() > 0 && self.panel_dependency_ready(state)
        })
    }

    fn has_unloaded_ready_work(&self) -> bool {
        self.panels.values().any(|state| {
            !state.loaded && state.remaining_atoms() > 0 && self.panel_dependency_ready(state)
        })
    }

    fn has_inflight_hbm(&self) -> bool {
        self.panels.values().any(|state| !state.loaded)
            || self
                .job_schedules
                .iter()
                .any(|schedule| !schedule.shared_gate_ready)
    }

    fn bank_port_blocked(&self) -> bool {
        !self.free_cores.is_empty()
            && self.find_dispatch_pair(false, false).is_none()
            && self.find_dispatch_pair(true, false).is_none()
            && (self.find_dispatch_pair(false, true).is_some()
                || self.find_dispatch_pair(true, true).is_some())
    }
}

struct ReplayTimingCounters {
    hbm_last_completion_cycle: u64,
    hbm_starved_cycles: u64,
    hbm_active_cycles: u64,
    load_compute_overlap_cycles: u64,
    bank_port_stall_cycles: u64,
    cycle_breakdown: CycleBreakdown,
}

fn finalize_replay(
    dispatcher: DynamicExpertDispatcher,
    architecture: MknArchitectureManifest,
    total_cycles: u64,
    actual_hbm_bytes: u64,
    actual_hbm_write_bytes: u64,
    expected_hbm_bytes: u64,
    expected_useful_macs: u64,
    hbm_address_sha256: String,
    channel_telemetry: Vec<ramulator::raw::ChannelTelemetry>,
    native_transaction_bytes: u64,
    physical_equivalence: Option<PhysicalEquivalenceContract>,
    timing: ReplayTimingCounters,
) -> ReplayRun {
    assert!(dispatcher.pending_panels.is_empty());
    assert!(dispatcher.panels.is_empty());
    assert_eq!(dispatcher.completed_panels, dispatcher.total_panels);
    assert!(dispatcher.all_cores_free());
    assert!(dispatcher.all_weight_banks_free());
    assert!(!dispatcher.reducer_busy && dispatcher.reducer_queue.is_empty());
    assert!(!dispatcher.vector_busy && dispatcher.vector_queue.is_empty());
    assert!(!dispatcher.combine_busy && dispatcher.combine_queue.is_empty());
    assert!(
        dispatcher
            .token_remaining_contributions
            .iter()
            .all(|remaining| *remaining == 0)
    );
    assert!(dispatcher.scheduled_events.is_empty());

    let effective = if dispatcher.issued_macs == 0 {
        0.0
    } else {
        dispatcher.useful_macs as f64 / dispatcher.issued_macs as f64
    };
    let physical_byte_gate_passed = actual_hbm_bytes == expected_hbm_bytes;
    assert!(
        physical_byte_gate_passed,
        "MKN replay physical-byte gate failed"
    );
    let active_pe_capacity = dispatcher
        .core_busy_cycles
        .iter()
        .zip(architecture.cores.iter())
        .map(|(cycles, core)| cycles * core.pes())
        .sum::<u64>();
    let active_array_occupancy = dispatcher.issued_macs as f64 / active_pe_capacity.max(1) as f64;
    let system_pe_utilization =
        dispatcher.useful_macs as f64 / (BASELINE_PES * total_cycles.max(1)) as f64;
    let useful_mac_equivalence_passed = dispatcher.useful_macs == expected_useful_macs
        && physical_equivalence
            .as_ref()
            .is_none_or(|contract| dispatcher.useful_macs == contract.useful_macs);
    assert!(useful_mac_equivalence_passed, "MKN useful-MAC gate failed");
    let token_completion_gate_passed =
        dispatcher.completed_tokens == dispatcher.token_remaining_contributions.len();
    assert!(
        token_completion_gate_passed,
        "MKN token completion gate failed"
    );
    let zero_intermediate_writeback_passed = actual_hbm_write_bytes == 0
        && physical_equivalence.as_ref().is_none_or(|contract| {
            contract.intermediate_activation_offchip_write_bytes == actual_hbm_write_bytes
        });
    assert!(
        zero_intermediate_writeback_passed,
        "intermediate activation reached HBM"
    );
    assert_eq!(timing.cycle_breakdown.total(), total_cycles);

    let total_controller_reads = channel_telemetry
        .iter()
        .map(|channel| channel.read_requests)
        .sum::<u64>();
    assert_eq!(
        total_controller_reads * native_transaction_bytes,
        actual_hbm_bytes,
        "Ramulator channel counters disagree with issued physical reads"
    );
    let mean_channel_reads = total_controller_reads as f64 / HBM_CHANNELS as f64;
    let maximum_channel_reads = channel_telemetry
        .iter()
        .map(|channel| channel.read_requests)
        .max()
        .unwrap_or(0);
    let minimum_channel_reads = channel_telemetry
        .iter()
        .map(|channel| channel.read_requests)
        .min()
        .unwrap_or(0);
    let hbm_channel_skew = if mean_channel_reads == 0.0 {
        0.0
    } else {
        (maximum_channel_reads - minimum_channel_reads) as f64 / mean_channel_reads
    };
    let total_row_hits = channel_telemetry
        .iter()
        .map(|value| value.row_hits)
        .sum::<u64>();
    let total_row_misses = channel_telemetry
        .iter()
        .map(|value| value.row_misses)
        .sum::<u64>();
    let total_row_conflicts = channel_telemetry
        .iter()
        .map(|value| value.row_conflicts)
        .sum::<u64>();
    let total_row_events = total_row_hits + total_row_misses + total_row_conflicts;
    let rate = |value: u64, total: u64| value as f64 / total.max(1) as f64;
    let hbm_channels = channel_telemetry
        .into_iter()
        .map(|channel| {
            let row_events = channel.row_hits + channel.row_misses + channel.row_conflicts;
            HbmChannelReport {
                channel: channel.channel,
                cycles: channel.cycles,
                read_requests: channel.read_requests,
                read_requests_served: channel.read_requests_served,
                native_transaction_bytes,
                physical_read_bytes: channel.read_requests * native_transaction_bytes,
                bytes_per_layer_cycle: channel.read_requests as f64
                    * native_transaction_bytes as f64
                    / total_cycles.max(1) as f64,
                load_fraction: channel.read_requests as f64 / total_controller_reads.max(1) as f64,
                row_hits: channel.row_hits,
                row_misses: channel.row_misses,
                row_conflicts: channel.row_conflicts,
                row_hit_rate: rate(channel.row_hits, row_events),
                row_conflict_rate: rate(channel.row_conflicts, row_events),
            }
        })
        .collect::<Vec<_>>();

    let recipe_peaks = architecture
        .micro_recipe_table
        .iter()
        .map(|recipe| recipe.peak_sram.clone())
        .collect::<Vec<_>>();
    let peak_matrix_sram_bytes = recipe_peaks
        .iter()
        .map(|peak| peak.matrix_bytes)
        .max()
        .unwrap_or(0);
    let peak_vector_sram_bytes = recipe_peaks
        .iter()
        .map(|peak| peak.vector_bytes)
        .max()
        .unwrap_or(0);
    let peak_accumulator_bytes = recipe_peaks
        .iter()
        .map(|peak| peak.accumulator_bytes)
        .max()
        .unwrap_or(0);
    let peak_accumulator_slots = recipe_peaks
        .iter()
        .map(|peak| peak.accumulator_slots)
        .max()
        .unwrap_or(0);
    let typed_sram_capacity_passed = architecture.sram_contract.as_ref().is_none_or(|sram| {
        peak_matrix_sram_bytes <= sram.matrix_sram_bytes
            && peak_vector_sram_bytes <= sram.vector_sram_bytes
            && peak_accumulator_bytes <= sram.accumulator_bytes
    });
    let hbm_physical_byte_equivalence_passed = physical_byte_gate_passed
        && physical_equivalence
            .as_ref()
            .is_none_or(|contract| contract.hbm_physical_bytes == actual_hbm_bytes);
    let hbm_address_digest_equivalence_passed = physical_equivalence
        .as_ref()
        .is_none_or(|contract| contract.hbm_address_sha256 == hbm_address_sha256);
    assert!(
        hbm_physical_byte_equivalence_passed,
        "Python/Rust physical-byte gate failed"
    );
    assert!(
        hbm_address_digest_equivalence_passed,
        "Python/Rust HBM address-digest gate failed"
    );
    ReplayRun {
        architecture: architecture.clone(),
        equal_area_pes: architecture.pe_count(),
        provisioned_input_width: PROVISIONED_INPUT_WIDTH,
        used_input_width: architecture.used_input_width(),
        provisioned_output_slots: PROVISIONED_OUTPUT_SLOTS,
        used_output_slots: architecture.used_output_slots(),
        completed_jobs: dispatcher.completed_jobs,
        completed_tokens: dispatcher.completed_tokens,
        completed_panels: dispatcher.completed_panels,
        total_cycles,
        executor_drained_cycles: 0,
        hbm_physical_bytes: actual_hbm_bytes,
        hbm_physical_write_bytes: actual_hbm_write_bytes,
        expected_hbm_physical_bytes: expected_hbm_bytes,
        hbm_read_requests_64b: actual_hbm_bytes / HBM_BURST_BYTES,
        hbm_address_sha256,
        hbm_channels,
        hbm_channel_skew,
        hbm_row_hit_rate: rate(total_row_hits, total_row_events),
        hbm_row_conflict_rate: rate(total_row_conflicts, total_row_events),
        hbm_last_completion_cycle: timing.hbm_last_completion_cycle,
        hbm_starved_cycles: timing.hbm_starved_cycles,
        hbm_active_cycles: timing.hbm_active_cycles,
        achieved_hbm_bytes_per_cycle: actual_hbm_bytes as f64 / total_cycles.max(1) as f64,
        hbm_bandwidth_utilization: actual_hbm_bytes as f64
            / (total_cycles.max(1) as f64 * HBM_THEORETICAL_BYTES_PER_CYCLE),
        transferred_hbm_reference_pressure_ratio: actual_hbm_bytes as f64
            / (total_cycles.max(1) as f64 * TRANSFERRED_HBM_REFERENCE_BYTES_PER_CYCLE),
        load_compute_overlap_cycles: timing.load_compute_overlap_cycles,
        load_compute_overlap_ratio: timing.load_compute_overlap_cycles as f64
            / timing.hbm_active_cycles.max(1) as f64,
        max_live_weight_panels: dispatcher.max_live_panels,
        weight_panel_buffer_depth: architecture.buffer_depth,
        weight_buffer_banks: architecture.weight_buffer_banks,
        scheduler_kind: architecture.scheduler.policy.clone(),
        dispatch_mode_macro_tiles: dispatcher.dispatch_mode_macro_tiles,
        job_mapping_modes: dispatcher
            .job_schedules
            .iter()
            .map(|schedule| (schedule.label.clone(), schedule.mode.name().to_string()))
            .collect(),
        dynamic_dispatches: dispatcher.dynamic_dispatches,
        work_steal_events: dispatcher.work_steal_events,
        mode_switch_events: dispatcher.mode_switch_events,
        mode_switch_core_cycles: dispatcher.mode_switch_core_cycles,
        bank_port_stall_cycles: timing.bank_port_stall_cycles,
        core_idle_cycles: dispatcher
            .core_busy_cycles
            .iter()
            .map(|busy| total_cycles.saturating_sub(*busy))
            .collect(),
        core_busy_cycles: dispatcher.core_busy_cycles,
        core_macro_tiles: dispatcher.core_macro_tiles,
        core_completion_skew_cycles: dispatcher
            .core_last_completion_cycles
            .iter()
            .max()
            .unwrap_or(&0)
            .saturating_sub(
                *dispatcher
                    .core_last_completion_cycles
                    .iter()
                    .min()
                    .unwrap_or(&0),
            ),
        core_last_completion_cycles: dispatcher.core_last_completion_cycles,
        useful_macs: dispatcher.useful_macs,
        issued_macs: dispatcher.issued_macs,
        effective_mac_utilization: effective,
        padding_efficiency: effective,
        active_array_occupancy,
        system_pe_utilization,
        reducer_busy_cycles: dispatcher.reducer_busy_cycles,
        reducer_queue_wait_cycles: dispatcher.reducer_queue_wait_cycles,
        reduction_output_elements: dispatcher.reduction_output_elements,
        reduction_add_elements: dispatcher.reduction_add_elements,
        interconnect_bytes: dispatcher.interconnect_bytes,
        activation_busy_cycles: dispatcher.activation_busy_cycles,
        activation_vector_cycles: dispatcher
            .job_schedules
            .iter()
            .map(|schedule| schedule.activation_cycles)
            .sum(),
        completion_busy_cycles: dispatcher.completion_busy_cycles,
        completion_vector_cycles: dispatcher
            .job_schedules
            .iter()
            .map(|schedule| schedule.completion_vector_cycles)
            .sum(),
        token_combine_busy_cycles: dispatcher.combine_busy_cycles,
        token_combine_queue_wait_cycles: dispatcher.combine_queue_wait_cycles,
        token_combine_add_elements: dispatcher.combine_add_elements,
        cycle_breakdown: timing.cycle_breakdown,
        peak_matrix_sram_bytes,
        peak_vector_sram_bytes,
        peak_accumulator_bytes,
        peak_accumulator_slots,
        intermediate_activation_offchip_write_bytes: actual_hbm_write_bytes,
        useful_mac_equivalence_passed,
        hbm_physical_byte_equivalence_passed,
        hbm_address_digest_equivalence_passed,
        zero_intermediate_writeback_passed,
        typed_sram_capacity_passed,
        token_completion_gate_passed,
        deterministic_sequence_events: dispatcher.next_sequence,
        all_atoms_completed: true,
        physical_byte_gate_passed,
        resource_contract_passed: architecture.pe_count() == BASELINE_PES
            && architecture.used_input_width() <= PROVISIONED_INPUT_WIDTH
            && architecture.used_output_slots() <= PROVISIONED_OUTPUT_SLOTS,
        executor_drain_passed: false,
    }
}

async fn replay_controller(
    hbm: Arc<dyn ErasedMemoryModel>,
    hbm_telemetry: ramulator::Ramulator,
    jobs: Vec<LogicalJob>,
    architecture: MknArchitectureManifest,
    physical_equivalence: Option<PhysicalEquivalenceContract>,
) -> ReplayRun {
    let expected_jobs = jobs.len();
    let (panels, panel_totals) = build_panels(&jobs, &architecture);
    let hbm_address_sha256 = canonical_hbm_address_digest(&jobs, &panels);
    let expected_useful_macs = jobs
        .iter()
        .map(|job| {
            job.tokens
                * (2 * job.projections[0].k * job.projections[0].n
                    + job.projections[2].k * job.projections[2].n)
        })
        .sum::<u64>();
    let expected_bytes = panels.iter().map(WeightPanel::physical_bytes).sum::<u64>()
        + jobs
            .iter()
            .filter_map(|job| job.shared_gate.as_ref())
            .map(|gate| gate.physical_bytes)
            .sum::<u64>();
    let (sender, mut receiver) = mpsc::unbounded_channel();
    let mut dispatcher =
        DynamicExpertDispatcher::new(architecture.clone(), &jobs, panels, panel_totals, sender);
    let mut events = BTreeMap::<(u64, u64), Event>::new();
    let mut observation_cycle = 0;
    let mut hbm_last_completion_cycle = 0;
    let mut hbm_starved_cycles = 0;
    let mut hbm_active_cycles = 0;
    let mut load_compute_overlap_cycles = 0;
    let mut bank_port_stall_cycles = 0;
    let mut cycle_breakdown = CycleBreakdown::default();

    dispatcher.launch_shared_gates(&hbm, &jobs);
    dispatcher.launch_pending(&hbm);
    let expected_tokens = dispatcher.token_remaining_contributions.len();
    while dispatcher.completed_tokens < expected_tokens {
        dispatcher.set_current_cycle(cycle_now());
        dispatcher.dispatch();
        dispatcher.start_reducer();
        dispatcher.start_vector();
        dispatcher.start_combine();
        dispatcher.drain_scheduled_events(&mut events);
        loop {
            let now = cycle_now();
            match events.keys().next().map(|key| key.0) {
                Some(cycle) if cycle <= now => break,
                Some(cycle) => {
                    let deadline = Instant::INIT + PERIOD * cycle;
                    tokio::select! {
                        _ = Executor::current().resolve_at(deadline) => {}
                        event = receiver.recv() => {
                            let event = event.expect(
                                "MKN replay workers exited before all jobs completed"
                            );
                            assert!(events.insert(event.key(), event).is_none());
                        }
                    }
                }
                None => {
                    let event = receiver
                        .recv()
                        .await
                        .expect("MKN replay workers exited before all jobs completed");
                    assert!(events.insert(event.key(), event).is_none());
                }
            }
            while let Ok(event) = receiver.try_recv() {
                assert!(events.insert(event.key(), event).is_none());
            }
        }
        let next_cycle = events.keys().next().unwrap().0;
        assert!(next_cycle <= cycle_now());
        let interval_cycles = next_cycle.saturating_sub(observation_cycle);
        if dispatcher.has_inflight_hbm() {
            hbm_active_cycles += interval_cycles;
            if dispatcher.has_compute_inflight() {
                load_compute_overlap_cycles += interval_cycles;
            }
        }
        let waiting_only_for_hbm = dispatcher.all_cores_free()
            && !dispatcher.has_loaded_ready_work()
            && dispatcher.has_unloaded_ready_work();
        if waiting_only_for_hbm {
            hbm_starved_cycles += interval_cycles;
        }
        if dispatcher.bank_port_blocked() {
            bank_port_stall_cycles += interval_cycles;
        }
        if waiting_only_for_hbm {
            cycle_breakdown.hbm_starvation_cycles += interval_cycles;
        } else if dispatcher.vector_busy {
            cycle_breakdown.vector_swiglu_cycles += interval_cycles;
        } else if dispatcher.combine_busy {
            cycle_breakdown.token_combine_cycles += interval_cycles;
        } else if dispatcher.has_compute_inflight() || dispatcher.reducer_busy {
            cycle_breakdown.compute_cycles += interval_cycles;
        } else if !dispatcher.switching_cores.is_empty() {
            cycle_breakdown.gang_mode_switch_wait_cycles += interval_cycles;
        } else {
            cycle_breakdown.gang_mode_switch_wait_cycles += interval_cycles;
        }
        observation_cycle = next_cycle;
        dispatcher.set_current_cycle(next_cycle);
        let keys = events
            .range((next_cycle, 0)..=(next_cycle, u64::MAX))
            .map(|(key, _)| *key)
            .collect::<Vec<_>>();
        for key in keys {
            let event = events.remove(&key).unwrap();
            if let Event::PanelReady { cycle, .. } | Event::SharedGateReady { cycle, .. } = &event {
                hbm_last_completion_cycle = hbm_last_completion_cycle.max(*cycle);
            }
            dispatcher.handle(event);
        }
        dispatcher.launch_pending(&hbm);
    }

    assert!(events.is_empty());
    assert_eq!(dispatcher.completed_jobs, expected_jobs);

    let total_cycles = cycle_now();
    let stats = hbm.statistics().expect("MKN replay HBM must expose stats");
    let native_transaction_bytes = hbm_telemetry.transfer_size() as u64;
    let channel_telemetry = hbm_telemetry
        .channel_telemetry()
        .expect("MKN replay Ramulator channel telemetry must be available");
    finalize_replay(
        dispatcher,
        architecture,
        total_cycles,
        stats.total_bytes_read,
        stats.total_bytes_written,
        expected_bytes,
        expected_useful_macs,
        hbm_address_sha256,
        channel_telemetry,
        native_transaction_bytes,
        physical_equivalence,
        ReplayTimingCounters {
            hbm_last_completion_cycle,
            hbm_starved_cycles,
            hbm_active_cycles,
            load_compute_overlap_cycles,
            bank_port_stall_cycles,
            cycle_breakdown,
        },
    )
}

async fn run_isolated(
    jobs: Vec<LogicalJob>,
    architecture: MknArchitectureManifest,
    physical_equivalence: Option<PhysicalEquivalenceContract>,
) -> ReplayRun {
    tokio::task::spawn_blocking(move || {
        let host = tokio::runtime::Builder::new_current_thread()
            .build()
            .expect("failed to build isolated MKN host runtime");
        host.block_on(async move {
            let executor = Executor::new();
            let result = Arc::new(Mutex::new(None));
            let output = result.clone();
            executor.spawn(async move {
                let raw_hbm = ramulator::Ramulator::hbm2_preset(HBM_CHANNELS)
                    .expect("failed to create MKN replay Ramulator");
                let telemetry = raw_hbm.clone();
                let typed = Arc::new(memory::WithStats::new(memory::WithTiming::new(
                    ManuallyDrop::new(raw_hbm),
                    memory::NoData,
                )));
                let hbm: Arc<dyn ErasedMemoryModel> = typed;
                *output.lock().unwrap() = Some(
                    replay_controller(hbm, telemetry, jobs, architecture, physical_equivalence)
                        .await,
                );
            });
            executor.enter(Instant::ETERNITY).await;
            let drained = executor.now().as_picos().div_ceil(PERIOD.as_picos().max(1));
            let mut run = result
                .lock()
                .unwrap()
                .take()
                .expect("MKN replay produced no result");
            run.executor_drained_cycles = drained;
            run.executor_drain_passed = run.total_cycles == drained;
            assert!(run.executor_drain_passed, "MKN replay left pending events");
            run
        })
    })
    .await
    .expect("isolated MKN replay worker panicked")
}

#[derive(Debug, Serialize)]
struct Comparison {
    baseline: ReplayRun,
    candidate: ReplayRun,
    speedup_request_region: f64,
    hbm_byte_equality_passed: bool,
    completed_job_equality_passed: bool,
    equal_pe_count_passed: bool,
    equal_global_sram_contract_passed: bool,
}

#[derive(Debug, Serialize)]
struct Report {
    schema_version: u64,
    evidence_tier: &'static str,
    timing_source: &'static str,
    compute_partition_contract: &'static str,
    hbm_contract: &'static str,
    model: String,
    model_architecture: String,
    workload: String,
    phase: String,
    nominal_batch: u64,
    active_batch: u64,
    source_window_id: String,
    layer: u64,
    step: u64,
    batch: u64,
    top_k: u64,
    shared_experts: u64,
    shared_gate: String,
    active_routed_experts: usize,
    routed_pairs: u64,
    repeats: Vec<Comparison>,
    repeat_gate_passed: bool,
    limitations: Vec<&'static str>,
}

async fn compare_once(
    jobs: Vec<LogicalJob>,
    candidate_architecture: MknArchitectureManifest,
    physical_equivalence: Option<PhysicalEquivalenceContract>,
) -> Comparison {
    let baseline_architecture = MknArchitectureManifest::baseline_like(&candidate_architecture);
    baseline_architecture.validate().unwrap();
    let expected_jobs = jobs.len();
    let (baseline, candidate) = tokio::join!(
        run_isolated(
            jobs.clone(),
            baseline_architecture,
            physical_equivalence.clone()
        ),
        run_isolated(jobs, candidate_architecture, physical_equivalence),
    );
    comparison_from_runs(baseline, candidate, expected_jobs)
}

fn comparison_from_runs(
    baseline: ReplayRun,
    candidate: ReplayRun,
    expected_jobs: usize,
) -> Comparison {
    let hbm_byte_equality_passed = baseline.hbm_physical_bytes == candidate.hbm_physical_bytes;
    let completed_job_equality_passed =
        baseline.completed_jobs == expected_jobs && candidate.completed_jobs == expected_jobs;
    let equal_pe_count_passed = baseline.equal_area_pes == candidate.equal_area_pes;
    let equal_global_sram_contract_passed = baseline.provisioned_input_width
        == candidate.provisioned_input_width
        && baseline.provisioned_output_slots == candidate.provisioned_output_slots
        && baseline.weight_panel_buffer_depth == candidate.weight_panel_buffer_depth
        && baseline.weight_buffer_banks == candidate.weight_buffer_banks;
    assert!(hbm_byte_equality_passed);
    assert!(completed_job_equality_passed);
    assert!(equal_pe_count_passed);
    assert!(equal_global_sram_contract_passed);
    Comparison {
        speedup_request_region: baseline.total_cycles as f64 / candidate.total_cycles as f64,
        baseline,
        candidate,
        hbm_byte_equality_passed,
        completed_job_equality_passed,
        equal_pe_count_passed,
        equal_global_sram_contract_passed,
    }
}

fn read_cached_baselines(
    report_path: &Path,
    manifest: &GroupedManifest,
    architecture: &MknArchitectureManifest,
    repeat_count: usize,
) -> Vec<ReplayRun> {
    let bytes = std::fs::read(report_path)
        .unwrap_or_else(|err| panic!("failed to read baseline report {report_path:?}: {err}"));
    let report: serde_json::Value = serde_json::from_slice(&bytes)
        .unwrap_or_else(|err| panic!("failed to parse baseline report {report_path:?}: {err}"));
    assert!(matches!(
        report["schema_version"].as_u64(),
        Some(1) | Some(2)
    ));
    assert_eq!(
        report["source_window_id"].as_str(),
        Some(manifest.source_window_id.as_str()),
        "baseline report belongs to a different workload window"
    );
    assert_eq!(
        report["repeat_gate_passed"].as_bool(),
        Some(true),
        "baseline report did not pass its repeat gate"
    );
    let repeats = report["repeats"]
        .as_array()
        .expect("baseline report repeats must be an array");
    assert_eq!(
        repeats.len(),
        repeat_count,
        "baseline report repeat count differs from this replay"
    );
    repeats
        .iter()
        .map(|comparison| {
            let run: ReplayRun = serde_json::from_value(comparison["baseline"].clone())
                .expect("baseline report contains an invalid ReplayRun");
            assert_eq!(run.architecture.mapping, BASELINE_MAPPING);
            assert_eq!(run.architecture.buffer_depth, architecture.buffer_depth);
            assert_eq!(
                run.architecture.weight_buffer_banks,
                architecture.weight_buffer_banks
            );
            assert!(run.physical_byte_gate_passed);
            assert!(run.resource_contract_passed);
            assert!(run.executor_drain_passed);
            run
        })
        .collect()
}

pub(crate) async fn evaluate(
    architecture_path: &Path,
    workload_path: &Path,
    output_path: &Path,
    repeat_count: usize,
    baseline_report_path: Option<&Path>,
) {
    assert!((1..=10).contains(&repeat_count));
    let architecture = read_architecture(architecture_path);
    let manifest = read_workload(workload_path);
    let jobs = jobs_from_manifest(&manifest);
    let physical_equivalence = manifest.physical_equivalence.clone();
    let cached_baselines = baseline_report_path
        .map(|path| read_cached_baselines(path, &manifest, &architecture, repeat_count));
    let mut repeats = Vec::with_capacity(repeat_count);
    let mut digests = Vec::with_capacity(repeat_count);
    for repeat in 0..repeat_count {
        let comparison = if let Some(baselines) = &cached_baselines {
            let candidate = run_isolated(
                jobs.clone(),
                architecture.clone(),
                physical_equivalence.clone(),
            )
            .await;
            comparison_from_runs(baselines[repeat].clone(), candidate, jobs.len())
        } else {
            compare_once(
                jobs.clone(),
                architecture.clone(),
                physical_equivalence.clone(),
            )
            .await
        };
        digests.push(serde_json::to_vec(&comparison).unwrap());
        repeats.push(comparison);
    }
    let repeat_gate_passed = digests.iter().all(|digest| digest == &digests[0]);
    assert!(repeat_gate_passed, "MKN replay repeat gate failed");
    let report = Report {
        schema_version: 2,
        evidence_tier: "explicit software-tile MKN event replay with token combine and native Ramulator telemetry; not RTL sign-off",
        timing_source: "isolated runtime::Executor + 8-channel Ramulator request/tick/callback",
        compute_partition_contract: "schema-v3 m_t/k_h/n_i/n_o recipes bound rectangular physical-core tasks; Gate/Up finish full hidden-K reduction before SwiGLU, Down finishes full intermediate-K reduction before expert completion, and every useful atom retires exactly once",
        hbm_contract: "baseline and candidate issue identical compiler-DMA 64B element/scale accesses, including scale-request amplification; HBM2 Ramulator splits each access into four native 16B transactions whose controller counters drive channel and row metrics",
        model: manifest.model,
        model_architecture: manifest.architecture,
        workload: manifest.workload,
        phase: manifest.phase,
        nominal_batch: manifest.nominal_batch,
        active_batch: manifest.active_batch,
        source_window_id: manifest.source_window_id,
        layer: manifest.layer,
        step: manifest.step,
        batch: manifest.batch,
        top_k: manifest.top_k,
        shared_experts: manifest.shared_experts,
        shared_gate: if manifest.shared_gate.is_empty() {
            "none".to_string()
        } else {
            manifest.shared_gate
        },
        active_routed_experts: manifest.group_sizes.len(),
        routed_pairs: manifest.group_sizes.values().sum(),
        repeats,
        repeat_gate_passed,
        limitations: vec![
            "formal token-combine evidence requires workload schema v2 produced from a validated token-level route capture; legacy v1 histogram reconstruction is compatibility-only",
            "replay covers shared/routed expert weights, matrix work, SwiGLU activation, route-weight/scatter completion, and optional sigmoid shared gate; router and gather remain outside this replay region",
            "macro-tile latency terms match the analytical DSE and remain provisional until 1/2/4-way RTL calibration",
            "typed Matrix/Vector/Accumulator capacity is gated by the schema-v3 liveness contract; SRAM macro banking and PPA remain unsynthesized",
            "SwiGLU, route/scatter, and shared-gate vector cycles follow checked-in compiler lowering formulas rather than a full emitted instruction stream",
            "Stream-K uses deterministic aligned rectangular slices inside a 64-column panel; a production scheduler may choose a different legal order",
        ],
    };
    if let Some(parent) = output_path.parent() {
        std::fs::create_dir_all(parent).unwrap();
    }
    std::fs::write(
        output_path,
        serde_json::to_string_pretty(&report).unwrap() + "\n",
    )
    .unwrap_or_else(|err| panic!("failed to write MKN replay report {output_path:?}: {err}"));
}

