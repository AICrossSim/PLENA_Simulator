#[derive(Clone, Debug, Deserialize, Serialize)]
struct MicroTileRecipe {
    id: String,
    job_kind: String,
    hidden: u64,
    intermediate: u64,
    token_min: u64,
    token_max: u64,
    m_t: u64,
    k_h: u64,
    n_i: u64,
    n_o: u64,
    gate_up_buffer_depth: usize,
    down_buffer_depth: usize,
    loop_order: String,
    mapping_mode: String,
    peak_sram: RecipeSramPeak,
}

impl MicroTileRecipe {
    fn validate(&self) -> Result<(), String> {
        if self.id.trim().is_empty()
            || !["routed", "shared", "any"].contains(&self.job_kind.as_str())
            || self.token_min == 0
            || self.token_min > self.token_max
            || self.m_t == 0
            || self.k_h == 0
            || self.n_i == 0
            || self.n_o == 0
            || self.gate_up_buffer_depth == 0
            || self.down_buffer_depth == 0
        {
            return Err(format!("invalid micro recipe {}", self.id));
        }
        for dimension in [self.hidden, self.intermediate, self.k_h, self.n_i, self.n_o] {
            if !dimension.is_multiple_of(COMPILER_MLEN) {
                return Err(format!("recipe {} has a non-K64 dimension", self.id));
            }
        }
        if self.k_h > self.hidden || self.n_i > self.intermediate || self.n_o > self.hidden {
            return Err(format!(
                "recipe {} tile exceeds its model dimension",
                self.id
            ));
        }
        if !["expert_n_k", "expert_k_n", "token_n_k"].contains(&self.loop_order.as_str()) {
            return Err(format!("recipe {} has unsupported loop_order", self.id));
        }
        if self.mapping_mode != DYNAMIC_MAPPING && DispatchMode::parse(&self.mapping_mode).is_none()
        {
            return Err(format!("recipe {} has unsupported mapping_mode", self.id));
        }
        Ok(())
    }

    fn matches(&self, job: &LogicalJob) -> bool {
        let kind = match job.kind {
            JobKind::Shared => "shared",
            JobKind::Routed => "routed",
        };
        (self.job_kind == "any" || self.job_kind == kind)
            && self.hidden == job.projections[2].n
            && self.intermediate == job.projections[0].n
            && (self.token_min..=self.token_max).contains(&job.tokens)
    }
}

#[derive(Clone, Debug, Deserialize, Serialize)]
pub(crate) struct MknArchitectureManifest {
    pub(crate) schema_version: u64,
    pub(crate) name: String,
    pub(crate) mapping: String,
    pub(crate) buffer_depth: usize,
    #[serde(default = "default_weight_buffer_banks")]
    pub(crate) weight_buffer_banks: usize,
    #[serde(default)]
    pub(crate) scheduler: DynamicSchedulerConfig,
    #[serde(default)]
    pub(crate) hardware_contract: Option<HardwareContract>,
    #[serde(default)]
    hbm_contract: Option<HbmContract>,
    #[serde(default)]
    sram_contract: Option<SramContract>,
    #[serde(default)]
    micro_recipe_table: Vec<MicroTileRecipe>,
    pub(crate) cores: Vec<MknCore>,
}

impl MknArchitectureManifest {
    fn baseline_like(candidate: &Self) -> Self {
        Self {
            schema_version: 2,
            name: "baseline_1x_m4_k1024_n4".to_string(),
            mapping: BASELINE_MAPPING.to_string(),
            buffer_depth: candidate.buffer_depth,
            weight_buffer_banks: candidate.weight_buffer_banks,
            scheduler: candidate.scheduler.clone(),
            hardware_contract: candidate.hardware_contract.clone(),
            hbm_contract: candidate.hbm_contract.clone(),
            sram_contract: candidate.sram_contract.clone(),
            micro_recipe_table: candidate.micro_recipe_table.clone(),
            cores: vec![MknCore {
                id: 0,
                m: 4,
                k: 1024,
                n: 4,
            }],
        }
    }

    fn pe_count(&self) -> u64 {
        self.cores.iter().map(MknCore::pes).sum()
    }

    fn used_input_width(&self) -> u64 {
        self.cores.iter().map(|core| core.k).sum()
    }

    fn used_output_slots(&self) -> u64 {
        self.cores.iter().map(MknCore::output_slots).sum()
    }

    fn recipe_for_job(&self, job: &LogicalJob) -> Option<&MicroTileRecipe> {
        if self.schema_version < 3 {
            return None;
        }
        let matches = self
            .micro_recipe_table
            .iter()
            .filter(|recipe| recipe.matches(job))
            .collect::<Vec<_>>();
        assert_eq!(
            matches.len(),
            1,
            "schema v3 must select exactly one recipe for {:?} job tokens={} hidden={} intermediate={}",
            job.kind,
            job.tokens,
            job.projections[2].n,
            job.projections[0].n
        );
        matches.into_iter().next()
    }

    fn validate(&self) -> Result<(), String> {
        if !(1..=3).contains(&self.schema_version) {
            return Err(format!(
                "unsupported MKN architecture schema {}",
                self.schema_version
            ));
        }
        if self.name.trim().is_empty() || self.cores.is_empty() {
            return Err("architecture name and cores must be non-empty".to_string());
        }
        if self.cores.len() > 9 {
            return Err("architecture core count must be in 1..=9".to_string());
        }
        if ![STREAM_K_MAPPING, BASELINE_MAPPING, DYNAMIC_MAPPING].contains(&self.mapping.as_str()) {
            return Err(format!("unsupported mapping {}", self.mapping));
        }
        if !(1..=8).contains(&self.buffer_depth) {
            return Err("buffer_depth must be in 1..=8".to_string());
        }
        if self.weight_buffer_banks == 0 || self.weight_buffer_banks > self.buffer_depth {
            return Err("weight_buffer_banks must be in 1..=buffer_depth".to_string());
        }
        self.scheduler.validate()?;
        match &self.hardware_contract {
            Some(contract) if contract != &HardwareContract::default() => {
                return Err(
                    "architecture hardware_contract disagrees with this replay engine".to_string(),
                );
            }
            None if self.schema_version >= 2 => {
                return Err("schema v2 architecture must declare hardware_contract".to_string());
            }
            _ => {}
        }
        if self.schema_version >= 3 {
            if self.hbm_contract.as_ref() != Some(&HbmContract::default()) {
                return Err("schema v3 requires the fixed HBM2-2000 8x64-bit contract".to_string());
            }
            let sram = self
                .sram_contract
                .as_ref()
                .ok_or_else(|| "schema v3 requires sram_contract".to_string())?;
            if min3(
                sram.matrix_sram_bytes,
                sram.vector_sram_bytes,
                sram.accumulator_bytes,
            ) == 0
            {
                return Err("typed SRAM capacities must be positive".to_string());
            }
            if !["explicit_per_core", "shared_pool"].contains(&sram.allocation_policy.as_str()) {
                return Err("unsupported SRAM allocation policy".to_string());
            }
            if sram.allocation_policy == "explicit_per_core" {
                if sram.per_core.len() != self.cores.len() {
                    return Err("explicit SRAM allocation must cover every core".to_string());
                }
                for (index, allocation) in sram.per_core.iter().enumerate() {
                    if allocation.core_id != index
                        || min3(
                            allocation.matrix_sram_bytes,
                            allocation.vector_sram_bytes,
                            allocation.accumulator_bytes,
                        ) == 0
                    {
                        return Err("invalid explicit per-core SRAM allocation".to_string());
                    }
                }
                if sram
                    .per_core
                    .iter()
                    .map(|value| value.matrix_sram_bytes)
                    .sum::<u64>()
                    != sram.matrix_sram_bytes
                    || sram
                        .per_core
                        .iter()
                        .map(|value| value.vector_sram_bytes)
                        .sum::<u64>()
                        != sram.vector_sram_bytes
                    || sram
                        .per_core
                        .iter()
                        .map(|value| value.accumulator_bytes)
                        .sum::<u64>()
                        != sram.accumulator_bytes
                {
                    return Err(
                        "per-core SRAM allocations do not conserve global capacity".to_string()
                    );
                }
            }
            if self.micro_recipe_table.is_empty() {
                return Err("schema v3 requires a non-empty micro_recipe_table".to_string());
            }
            for recipe in &self.micro_recipe_table {
                recipe.validate()?;
                let actual = recipe_sram_peak(recipe);
                if actual != recipe.peak_sram {
                    return Err(format!(
                        "recipe {} peak_sram disagrees with Rust liveness",
                        recipe.id
                    ));
                }
                if actual.matrix_bytes > sram.matrix_sram_bytes
                    || actual.vector_bytes > sram.vector_sram_bytes
                    || actual.accumulator_bytes > sram.accumulator_bytes
                    || actual.accumulator_slots > PROVISIONED_OUTPUT_SLOTS
                {
                    return Err(format!("recipe {} exceeds typed SRAM capacity", recipe.id));
                }
                if sram.allocation_policy == "explicit_per_core"
                    && sram.per_core.iter().any(|allocation| {
                        actual.matrix_bytes > allocation.matrix_sram_bytes
                            || actual.vector_bytes > allocation.vector_sram_bytes
                            || actual.accumulator_bytes > allocation.accumulator_bytes
                    })
                {
                    return Err(format!(
                        "recipe {} is not dispatchable within every core's typed SRAM quota",
                        recipe.id
                    ));
                }
            }
        }
        for (index, core) in self.cores.iter().enumerate() {
            if core.id != index {
                return Err(format!(
                    "core id {} must equal its zero-based manifest index {index}",
                    core.id
                ));
            }
            if core.m == 0 || core.k == 0 || core.n == 0 {
                return Err(format!("core {index} has a zero dimension"));
            }
            if core.m > 16 || core.k > 1024 || core.n > 16 {
                return Err(format!("core {index} exceeds M<=16, K<=1024, N<=16"));
            }
            if !core.k.is_multiple_of(COMPILER_MLEN) {
                return Err(format!("core {index} K={} is not 64-aligned", core.k));
            }
            if !core.k.is_multiple_of(core.m) {
                return Err(format!(
                    "core {index} K={} is not divisible by M={}",
                    core.k, core.m
                ));
            }
        }
        if self.pe_count() != BASELINE_PES {
            return Err(format!(
                "{} has {} PEs, expected {BASELINE_PES}",
                self.name,
                self.pe_count()
            ));
        }
        if self.used_input_width() > PROVISIONED_INPUT_WIDTH {
            return Err(format!(
                "{} uses input width {}, budget is {PROVISIONED_INPUT_WIDTH}",
                self.name,
                self.used_input_width()
            ));
        }
        if self.used_output_slots() > PROVISIONED_OUTPUT_SLOTS {
            return Err(format!(
                "{} uses {} output slots, budget is {PROVISIONED_OUTPUT_SLOTS}",
                self.name,
                self.used_output_slots()
            ));
        }
        Ok(())
    }
}

