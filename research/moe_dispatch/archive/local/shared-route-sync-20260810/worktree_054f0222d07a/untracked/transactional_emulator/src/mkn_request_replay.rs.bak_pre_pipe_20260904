#[derive(Debug)]
enum Event {
    PanelReady {
        sequence: u64,
        cycle: u64,
        panel_id: usize,
    },
    CoreDone {
        sequence: u64,
        cycle: u64,
        task: Task,
    },
    WeightBankReleased {
        sequence: u64,
        cycle: u64,
        bank_id: usize,
    },
    CoreModeSwitchDone {
        sequence: u64,
        cycle: u64,
        core_id: usize,
    },
    SharedGateReady {
        sequence: u64,
        cycle: u64,
        job_id: usize,
    },
    ReductionDone {
        sequence: u64,
        cycle: u64,
        reduction: Reduction,
    },
    VectorDone {
        sequence: u64,
        cycle: u64,
        work: VectorWork,
    },
    CombineDone {
        sequence: u64,
        cycle: u64,
        work: CombineWork,
    },
}

impl Event {
    fn key(&self) -> (u64, u64) {
        match self {
            Self::PanelReady {
                sequence, cycle, ..
            }
            | Self::CoreDone {
                sequence, cycle, ..
            }
            | Self::WeightBankReleased {
                sequence, cycle, ..
            }
            | Self::CoreModeSwitchDone {
                sequence, cycle, ..
            }
            | Self::SharedGateReady {
                sequence, cycle, ..
            }
            | Self::ReductionDone {
                sequence, cycle, ..
            }
            | Self::VectorDone {
                sequence, cycle, ..
            }
            | Self::CombineDone {
                sequence, cycle, ..
            } => (*cycle, *sequence),
        }
    }
}

fn cycle_now() -> u64 {
    Executor::current()
        .now()
        .as_picos()
        .div_ceil(PERIOD.as_picos().max(1))
}

fn launch_panel_transfer(
    hbm: Arc<dyn ErasedMemoryModel>,
    panel: WeightPanel,
    sequence: u64,
    sender: mpsc::UnboundedSender<Event>,
) {
    Executor::current().spawn(async move {
        let mut addresses = Vec::new();
        append_panel_addresses(&panel, &mut addresses);
        issue_addresses(&hbm, &mut addresses).await;
        sender
            .send(Event::PanelReady {
                sequence,
                cycle: cycle_now(),
                panel_id: panel.id,
            })
            .expect("MKN replay scheduler dropped before panel transfer completed");
    });
}

fn launch_shared_gate_transfer(
    hbm: Arc<dyn ErasedMemoryModel>,
    job_id: usize,
    gate: SharedGateProjection,
    sequence: u64,
    sender: mpsc::UnboundedSender<Event>,
) {
    Executor::current().spawn(async move {
        let mut addresses = (0..gate.physical_bytes)
            .step_by(HBM_BURST_BYTES as usize)
            .map(|offset| gate.base + offset)
            .collect::<Vec<_>>();
        issue_addresses(&hbm, &mut addresses).await;
        sender
            .send(Event::SharedGateReady {
                sequence,
                cycle: cycle_now(),
                job_id,
            })
            .expect("MKN dispatcher dropped before shared-gate transfer completed");
    });
}

