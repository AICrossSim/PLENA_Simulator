+def split_config(core):
+    control = (core.get("refinement") or {}).get("stream_ctrl") or {}
+    return control.get("split_window") if control.get("split_slot_lifetime", False) else None
+
+
+def resident_slots(core):
+    split = split_config(core)
+    return split["window_tiles"] if split is not None else core.get("weight_slots", 2)
+
+
+
+def oracle_mode(architecture):
+    mode = (architecture.get("diagnostic") or {}).get("oracle_control", "charged")
+    require(mode in ("charged", "zero_control", "desc_only", "lifecycle_only"), "invalid control oracle")
+    return mode
+
+
+def oracle_paid(category, cycles, architecture):
+    mode = oracle_mode(architecture)
+    desc = {"header", "install", "mask"}
+    lifecycle = {"load", "arrival", "operand_bind", "packed_retire", "operand_retire", "burst_start", "burst_complete"}
+    waived = mode == "zero_control" or mode == "desc_only" and category in desc or mode == "lifecycle_only" and category in lifecycle
+    legacy_zero = (architecture.get("diagnostic") or {}).get("event_updates_zero_cost", False)
+    waived |= legacy_zero and category in {"arrival", "install", "burst_complete", "mask"}
+    return 0 if waived else cycles * architecture["clock_period_ps"]
+
+
+def oracle_categories(admissions, tiles, issues, bursts, masks):
+    return dict(admission=admissions, header=tiles, load=2 * tiles, arrival=tiles,
+                install=issues, operand_bind=2 * tiles, packed_retire=2 * tiles,
+                operand_retire=2 * tiles, burst_start=2 * bursts, burst_complete=2 * bursts, mask=masks)
+
+
+def validate_oracle_control(observed, core, architecture):
+    detail = observed["refinement"]
+    stream, pool = detail["stream_ctrl"], detail["output_pool"]
+    report = stream.get("oracle_control")
+    if report is None:
+        idle = observed["jobs"] == 0 and pool["scheduler_visits"] == pool["scheduler_busy_ps"] == 0
+        require(idle or oracle_mode(architecture) == "charged", "control oracle has no category evidence")
+        return
+    require(report["mode"] == oracle_mode(architecture), "control oracle mode differs")
+    mt = core["refinement"]["m_rows"]
+    admission = sum(p["metrics"]["band_admissions"] * ((p["m"] + mt - 1) // mt + 1) for p in observed["projections"])
+    expected = oracle_categories(admission, pool["tile_admissions"], pool["context_updates"],
+                                 stream["burst_starts"], stream["completion_mask_cycles"])
+    categories = report["categories"]
+    require(set(categories) <= set(expected), "unknown oracle control category")
+    for name, nominal in expected.items():
+        item = categories.get(name, dict(accesses=0, nominal_cycles=0, paid_ps=0, wait_ps=0))
+        require(all(type(item.get(k)) is int and item[k] >= 0 for k in ("accesses", "nominal_cycles", "paid_ps", "wait_ps")),
+                "invalid oracle category counters")
+        require(item["nominal_cycles"] == nominal and item["paid_ps"] == oracle_paid(name, nominal, architecture),
+                "oracle category cycle/service mismatch: " + name)
+        require((nominal == 0 and item["accesses"] == 0) or 0 < item["accesses"] <= nominal,
+                "oracle access count is inconsistent")
+    require(sum(expected.values()) == pool["scheduler_visits"], "oracle nominal control formula differs")
+    require(sum(c["paid_ps"] for c in categories.values()) == pool["scheduler_busy_ps"], "oracle paid control formula differs")
+    require(sum(c["wait_ps"] for c in categories.values()) == stream["scheduler_port_wait_ps"], "oracle control wait counters differ")
+
+def validate_split_lifetimes(observed, core, total_ps):
+    config = split_config(core)
+    report = observed["refinement"].get("split_window")
+    if config is None:
+        require(report is None, "disabled split lifetime produced state")
+        return
+    require(report is not None, "missing simultaneous lifetime evidence")
+    p, r, w = core["blen"], core["mlen"], config["window_tiles"]
+    packed, stage = p * (r // 8) * 9, p * r * 2
+    require(w in (3, 6) and config["aging_multiplier"] in (None, 2, 4, 8), "invalid split window")
+    count, load_sum = config["load_latency_samples"], config["load_latency_sum_ps"]
+    require(type(count) is int and count > 0 and type(load_sum) is int and load_sum > 0, "L is not measured")
+    expected_threshold = None if config["aging_multiplier"] is None else (config["aging_multiplier"] * load_sum + count - 1) // count
+    require(report["aging_threshold_ps"] == expected_threshold, "aging threshold not derived from frozen L")
+    require(report["packed_slots"] == w and report["packed_slot_bytes"] == packed
+            and report["operand_stage_bytes"] == stage
+            and report["weight_reserved_bytes"] == w * packed + 2 * stage <= core["weight_sram_bytes"],
+            "split physical storage reservation differs")
+    previous_time, peak, current, peak_seen = 0, 0, [0, 0, 0], False
+    for transition in report["lifetime_changes"]:
+        require(len(transition) == 4 and all(type(v) is int and v >= 0 for v in transition), "invalid lifetime transition")
+        at, pk, op, dec = transition
+        require(previous_time <= at <= total_ps, "lifetime time escapes execution")
+        require(pk % packed == 0 and op % stage == dec % stage == 0, "partial unowned storage")
+        require(pk <= w * packed and op + dec <= 2 * stage, "decode allocated a third operand stage")
+        require(pk + op + dec <= core["weight_sram_bytes"], "simultaneous live SRAM exceeds budget")
+        previous_time, current = at, [pk, op, dec]
+        peak = max(peak, sum(current))
+        peak_seen |= current == report["live_peak_classes"]
+    require(current == report["live_current_bytes"] == [0, 0, 0], "live buffers failed to drain")
+    require(peak == report["live_peak_bytes"] == sum(report["live_peak_classes"])
+            and (peak_seen or peak == 0), "peak is not a simultaneously observed allocation")
+    tiles = observed["refinement"]["output_pool"]["tile_admissions"]
+    require(report["window_header_updates"] == report["window_selections"] == report["packed_arrivals"]["count"] == tiles,
+            "packed tile not loaded exactly once")
+    require(report["window_header_bytes"] == 16 * w, "candidate registers are unpaid")
+    require(report["window_max_candidates"] <= w
+            and report["aging_reorders"] <= report["aged_selected"] <= tiles, "window arbitration exceeds bounds")
+    for field in ("landing_slot_wait_ps", "operand_stage_wait_ps", "packed_read_busy_ps", "decode_vector_busy_ps", "operand_write_busy_ps"):
+        require(0 <= report[field] <= total_ps, "split serialized service/full wait exceeds execution: " + field)
+    require(report["packed_read_busy_ps"] + report["operand_write_busy_ps"]
+            == observed["refinement"]["weight_port_busy_ps"], "split read/write port service does not reconcile")
+
