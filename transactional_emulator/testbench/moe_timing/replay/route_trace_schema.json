{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plena.route_trace.v2",
  "title": "PLENA MoE route trace v2",
  "description": "v2 adds the optional shared-expert block to `model`. A v1 trace is a valid v2 trace describing an architecture with no shared expert (GPT-OSS, Qwen3-MoE, Mixtral), so both versions are accepted by validate_route_trace.py.",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "created_by",
    "model",
    "workload",
    "routing",
    "artifacts",
    "replay"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "trace_id": { "type": "string" },
    "created_by": { "type": "string" },
    "model": {
      "type": "object",
      "required": ["name", "layer_index", "hidden_size", "intermediate_size", "num_experts", "top_k"],
      "properties": {
        "name": { "type": "string" },
        "layer_index": { "type": "integer", "minimum": 0 },
        "hidden_size": { "type": "integer", "minimum": 1 },
        "intermediate_size": { "type": "integer", "minimum": 1 },
        "num_experts": { "type": "integer", "minimum": 1 },
        "top_k": { "type": "integer", "minimum": 1 },
        "shared_experts": {
          "type": "integer",
          "minimum": 0,
          "description": "v2. Number of always-active shared experts. Absent or 0 for GPT-OSS / Qwen3-MoE / Mixtral. DeepSeek-V2-Lite is 2, DeepSeek-V3 / Qwen2-MoE / Llama-4 / GLM-4.5 are 1."
        },
        "shared_intermediate_size": {
          "type": "integer",
          "minimum": 1,
          "description": "v2. Width of the shared branch as replayed, i.e. already fused: DeepSeek emits a single MLP of moe_intermediate_size * shared_experts, so this is that product, not the per-expert width. Independent of intermediate_size for Qwen2-MoE and Qwen3-Next."
        },
        "shared_gate": {
          "enum": ["none", "sigmoid"],
          "description": "v2. 'sigmoid' is Qwen2-MoE's shared_expert_gate, a [hidden,1] projection whose sigmoid scales the shared output per token. Every other architecture adds the shared branch unweighted."
        }
      }
    },
    "workload": {
      "type": "object",
      "required": ["benchmark", "sample_id", "phase", "batch_size", "seq_len", "token_count"],
      "properties": {
        "benchmark": { "type": "string" },
        "sample_id": { "type": "string" },
        "phase": { "enum": ["prefill", "decode", "smoke", "unknown"] },
        "batch_size": { "type": "integer", "minimum": 1 },
        "seq_len": { "type": "integer", "minimum": 1 },
        "token_count": { "type": "integer", "minimum": 1 }
      }
    },
    "routing": {
      "type": "object",
      "required": ["source", "topk_indices", "topk_weights", "expert_counts", "duplicate_factor", "gini"],
      "properties": {
        "source": { "type": "string" },
        "topk_indices": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        },
        "topk_weights": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "number" } }
        },
        "expert_counts": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "duplicate_factor": { "type": "number" },
        "gini": { "type": "number" }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["reference_pt", "l1_golden_pt"],
      "properties": {
        "reference_pt": { "type": "string" },
        "l1_golden_pt": { "type": "string" },
        "fixed_route_build_dir": { "type": "string" },
        "device_selected_build_dir": { "type": "string" }
      }
    },
    "replay": {
      "type": "object",
      "required": ["harness_module", "stage", "mlen", "blen", "emu_threads"],
      "properties": {
        "harness_module": { "type": "string" },
        "stage": { "const": "full_vram" },
        "mlen": { "type": "integer", "minimum": 1 },
        "blen": { "type": "integer", "minimum": 1 },
        "emu_threads": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

