{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plena.dev/schemas/nemotron3-gpu-profile-v1.json",
  "title": "Nemotron 3 GPU profile contract",
  "type": "object",
  "required": ["schema_version", "model_id", "model_revision", "environment", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "required": [
        "gpu_model", "gpu_count", "driver_version", "cuda_version", "framework_version", "dtype", "state_dtype"
      ],
      "properties": {
        "gpu_model": {"type": "string", "minLength": 1},
        "gpu_count": {"type": "integer", "minimum": 1},
        "driver_version": {"type": "string", "minLength": 1},
        "cuda_version": {"type": "string", "minLength": 1},
        "framework_version": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "state_dtype": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase", "batch_size", "input_sequence_length", "context_length", "generated_tokens",
          "warmup_iterations", "measured_iterations", "ttft_us", "mean_token_latency_us", "kernels"
        ],
        "properties": {
          "phase": {"enum": ["prefill", "decode"]},
          "batch_size": {"type": "integer", "minimum": 1},
          "input_sequence_length": {"type": "integer", "minimum": 0},
          "context_length": {"type": "integer", "minimum": 0},
          "generated_tokens": {"type": "integer", "minimum": 0},
          "warmup_iterations": {"type": "integer", "minimum": 0},
          "measured_iterations": {"type": "integer", "minimum": 1},
          "ttft_us": {"type": "number", "minimum": 0},
          "mean_token_latency_us": {"type": "number", "minimum": 0},
          "kernels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "canonical_stage", "layer_type", "kernel_name", "calls", "total_time_us",
                "dram_read_bytes", "dram_write_bytes"
              ],
              "properties": {
                "canonical_stage": {"type": "string", "minLength": 1},
                "layer_type": {"enum": ["mamba", "moe", "attention", "model", "other"]},
                "kernel_name": {"type": "string", "minLength": 1},
                "calls": {"type": "integer", "minimum": 1},
                "total_time_us": {"type": "number", "minimum": 0},
                "dram_read_bytes": {"type": "integer", "minimum": 0},
                "dram_write_bytes": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
